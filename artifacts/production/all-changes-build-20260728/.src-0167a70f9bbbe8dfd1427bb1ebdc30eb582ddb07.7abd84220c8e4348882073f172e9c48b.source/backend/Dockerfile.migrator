# Dedicated migration runner. It owns one PostgreSQL advisory lock for the
# entire EF migration session and logs migration IDs only.
FROM mcr.microsoft.com/dotnet/sdk:9.0.201 AS build
WORKDIR /src

COPY NaderGorge.sln ./
COPY src/NaderGorge.API/NaderGorge.API.csproj src/NaderGorge.API/
COPY src/NaderGorge.Application/NaderGorge.Application.csproj src/NaderGorge.Application/
COPY src/NaderGorge.Domain/NaderGorge.Domain.csproj src/NaderGorge.Domain/
COPY src/NaderGorge.Infrastructure/NaderGorge.Infrastructure.csproj src/NaderGorge.Infrastructure/
COPY src/NaderGorge.Migrator/NaderGorge.Migrator.csproj src/NaderGorge.Migrator/
RUN dotnet restore src/NaderGorge.Migrator/NaderGorge.Migrator.csproj

COPY . .
RUN dotnet publish src/NaderGorge.Migrator/NaderGorge.Migrator.csproj \
    --configuration Release --no-restore --output /out

FROM mcr.microsoft.com/dotnet/aspnet:9.0.6
WORKDIR /app
COPY --from=build /out ./
USER 65532:65532
ENTRYPOINT ["dotnet", "NaderGorge.Migrator.dll"]

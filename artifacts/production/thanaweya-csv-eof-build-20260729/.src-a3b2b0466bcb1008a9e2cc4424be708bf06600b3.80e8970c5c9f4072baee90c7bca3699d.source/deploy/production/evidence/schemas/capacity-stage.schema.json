{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "runId",
    "releaseId",
    "requestedRps",
    "baselineRps",
    "profile",
    "excludedNode",
    "expectedNodes",
    "startedAt",
    "completedAt",
    "capturedAt",
    "loadEvidenceSha256",
    "thresholds",
    "samples",
    "violations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["success", "failed"] },
    "runId": { "type": "string", "minLength": 1 },
    "releaseId": {
      "type": "string",
      "pattern": "^(?:git-[0-9a-f]{7,40}|src-[0-9a-f]{40})$"
    },
    "requestedRps": { "type": "number", "exclusiveMinimum": 0 },
    "baselineRps": { "type": "number", "exclusiveMinimum": 0 },
    "profile": { "enum": ["steady", "n-minus-one", "rolling-deploy", "failover"] },
    "excludedNode": {
      "type": ["string", "null"],
      "enum": ["node-1", "node-2", "node-3", null]
    },
    "expectedNodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["node-1", "node-2", "node-3"] }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "loadEvidenceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "cpuBusyPercentMaximum",
        "cpuIowaitPercentMaximum",
        "cpuStealPercentMaximum",
        "memoryAvailablePercentMinimum",
        "diskFreePercentMinimum",
        "postgresConnectionUtilizationPercentMaximum",
        "postgresWaitingLocksMaximum",
        "postgresReplicationLagBytesMaximum",
        "redisMemoryUtilizationPercentMaximum",
        "redisBlockedClientsClusterTotalAbsoluteMaximum",
        "redisBlockedClientsClusterTotalIncreaseMaximum",
        "redisAofDelayedFsyncMaximum",
        "queueWaitingMaximum",
        "queueFailedMaximum",
        "queueStalledMaximum",
        "minimumDuringSamples",
        "maximumSampleAgeSeconds"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "cpuBusyPercentMaximum": { "type": "number", "minimum": 0, "maximum": 100 },
        "cpuIowaitPercentMaximum": { "type": "number", "minimum": 0, "maximum": 100 },
        "cpuStealPercentMaximum": { "type": "number", "minimum": 0, "maximum": 100 },
        "memoryAvailablePercentMinimum": { "type": "number", "minimum": 0, "maximum": 100 },
        "diskFreePercentMinimum": { "type": "number", "minimum": 0, "maximum": 100 },
        "postgresConnectionUtilizationPercentMaximum": { "type": "number", "minimum": 0, "maximum": 100 },
        "postgresWaitingLocksMaximum": { "type": "number", "minimum": 0 },
        "postgresReplicationLagBytesMaximum": { "type": "number", "minimum": 0 },
        "redisMemoryUtilizationPercentMaximum": { "type": "number", "minimum": 0, "maximum": 100 },
        "redisBlockedClientsClusterTotalAbsoluteMaximum": { "type": "number", "minimum": 0 },
        "redisBlockedClientsClusterTotalIncreaseMaximum": { "type": "number", "minimum": 0 },
        "redisAofDelayedFsyncMaximum": { "type": "number", "minimum": 0 },
        "queueWaitingMaximum": { "type": "number", "minimum": 0 },
        "queueFailedMaximum": { "type": "number", "minimum": 0 },
        "queueStalledMaximum": { "type": "number", "minimum": 0 },
        "minimumDuringSamples": { "type": "number", "minimum": 1 },
        "maximumSampleAgeSeconds": { "type": "number", "minimum": 1 }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "capturedAt", "nodes"],
        "properties": {
          "phase": { "enum": ["before", "during", "after"] },
          "capturedAt": { "type": "string", "format": "date-time" },
          "nodes": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "object" }
          }
        }
      }
    },
    "violations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

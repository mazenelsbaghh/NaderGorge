map $http_origin $massar_cors_origin {
    default "";
    "~^https://(app|admin|teacher|staff)\.massar-academy\.net$" $http_origin;
    "https://massar-academy.net" $http_origin;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
}

map $http_x_forwarded_proto $massar_forwarded_proto {
    default $http_x_forwarded_proto;
    "" https;
}

proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $massar_forwarded_proto;

server {
    listen 8080 default_server;
    server_name _;
    return 421;
}

server {
    listen 8080;
    server_name massar-academy.net;
    add_header X-Massar-Node "${MASSAR_NODE_ID}" always;
    add_header X-Massar-Release "${MASSAR_RELEASE_ID}" always;

    location = /__node_ready {
        access_log off;
        add_header Content-Type application/json;
        # `add_header` in a nested location replaces the server-level header
        # inheritance, so repeat the identity headers required by the strict
        # three-node ingress and load-distribution probes.
        add_header X-Massar-Node "${MASSAR_NODE_ID}" always;
        add_header X-Massar-Release "${MASSAR_RELEASE_ID}" always;
        return 200 '{"status":"healthy","nodeId":"${MASSAR_NODE_ID}","releaseId":"${MASSAR_RELEASE_ID}"}';
    }
    location / {
        proxy_pass http://landing:8738;
    }
}

server {
    listen 8080;
    server_name app.massar-academy.net;
    add_header X-Massar-Node "${MASSAR_NODE_ID}" always;
    add_header X-Massar-Release "${MASSAR_RELEASE_ID}" always;
    location / {
        proxy_pass http://student:8738;
    }
}

server {
    listen 8080;
    server_name admin.massar-academy.net;
    add_header X-Massar-Node "${MASSAR_NODE_ID}" always;
    add_header X-Massar-Release "${MASSAR_RELEASE_ID}" always;
    location / {
        proxy_pass http://admin:8738;
    }
}

server {
    listen 8080;
    server_name teacher.massar-academy.net;
    add_header X-Massar-Node "${MASSAR_NODE_ID}" always;
    add_header X-Massar-Release "${MASSAR_RELEASE_ID}" always;
    location / {
        proxy_pass http://teacher:8738;
    }
}

server {
    listen 8080;
    server_name staff.massar-academy.net;
    add_header X-Massar-Node "${MASSAR_NODE_ID}" always;
    add_header X-Massar-Release "${MASSAR_RELEASE_ID}" always;
    location / {
        proxy_pass http://staff:8738;
    }
}

server {
    listen 8080;
    server_name api.massar-academy.net;
    location / {
        proxy_pass http://backend:5245;
    }
}

server {
    listen 8080;
    server_name ws.massar-academy.net;
    location / {
        proxy_pass http://backend:5245;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }
}

server {
    listen 8080;
    server_name assets.massar-academy.net;
    root /var/www/assets;
    add_header X-Massar-Node "${MASSAR_NODE_ID}" always;
    add_header X-Massar-Release "${MASSAR_RELEASE_ID}" always;

    location ^~ /protected/ { return 404; }
    location ^~ /private/ { return 404; }
    location ^~ /.tmp/ { return 404; }
    location / {
        try_files $uri =404;
        add_header Access-Control-Allow-Origin "$massar_cors_origin" always;
        add_header Vary Origin always;
        add_header Cache-Control "public, max-age=2592000, no-transform";
    }
}

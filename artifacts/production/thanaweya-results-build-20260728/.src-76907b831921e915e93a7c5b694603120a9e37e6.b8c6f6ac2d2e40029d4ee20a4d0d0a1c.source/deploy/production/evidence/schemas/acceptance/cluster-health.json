{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "releaseId", "capturedAt", "healthyNodeCount", "postgresWriterCount", "redisMasterCount", "glusterSplitBrainCount", "sourceEvidenceSha256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "status": {"enum": ["success", "failed"]},
    "releaseId": {"type": "string", "pattern": "^(?:git-[0-9a-f]{7,40}|src-[0-9a-f]{40})$"},
    "capturedAt": {"type": "string", "format": "date-time"},
    "healthyNodeCount": {"type": "integer", "minimum": 0, "maximum": 3},
    "postgresWriterCount": {"type": "integer", "minimum": 0, "maximum": 3},
    "redisMasterCount": {"type": "integer", "minimum": 0, "maximum": 3},
    "glusterSplitBrainCount": {"type": "integer", "minimum": 0},
    "sourceEvidenceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev -p 8738",
    "build": "next build",
    "start": "next start -p 8738",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:platform-events": "node scripts/check-platform-event-contracts.mjs",
    "check:live-support-contracts": "node scripts/check-live-support-client-contracts.mjs",
    "check:admin-timezone": "node --no-warnings --experimental-strip-types src/components/admin/admin-utils.test.mts",
    "check:cairo-time-contracts": "node scripts/check-cairo-time-contracts.mjs",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "check:query-client": "node --no-warnings --experimental-strip-types src/lib/query-contracts.test.mts && node scripts/check-auth-query-boundary.mjs",
    "check:route-permissions": "node scripts/check-route-permission-contracts.mjs",
    "check:admin-student-paging": "node scripts/check-admin-student-paging-contracts.mjs",
    "check:route-performance-budgets": "node scripts/check-route-performance-budgets.mjs",
    "test:route-performance-budgets": "node --test scripts/check-route-performance-budgets.test.mjs",
    "baseline:routes": "node scripts/record-route-performance-baseline.mjs",
    "baseline:browser": "npm run build && PLAYWRIGHT_USE_PRODUCTION_BUILD=1 playwright test tests/e2e/platform-performance-baseline.spec.ts --project=chromium",
    "analyze": "ANALYZE=true next build",
    "check:accessibility": "node scripts/check-accessibility.mjs",
    "check:accessibility:browser": "node scripts/check-accessibility.mjs --browser",
    "check:accessible-colors": "node --no-warnings --experimental-strip-types src/lib/accessible-color.test.mts",
    "check:ui-review-fixes": "node scripts/check-ui-review-fixes.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@gsap/react": "^2.1.2",
    "@microsoft/signalr": "^10.0.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@types/three": "^0.183.1",
    "axios": "^1.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "gsap": "^3.14.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "next": "^16.2.7",
    "ogl": "^1.0.11",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-quill-new": "^3.7.0",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.183.2",
    "tus-js-client": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.15",
    "quill": "2.0.2"
  }
}

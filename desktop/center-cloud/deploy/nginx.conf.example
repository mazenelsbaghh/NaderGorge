# Integrate this server block with your existing certificate renewal setup.
server {
    listen 443 ssl;
    server_name support.example.invalid;
    ssl_certificate /etc/ssl/massar-support/fullchain.pem;
    ssl_certificate_key /etc/ssl/massar-support/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    access_log off;
    error_log /var/log/nginx/massar-support-error.log crit;
    client_max_body_size 128m;
    client_body_timeout 180s;
    client_header_timeout 10s;

    location /v1/ {
        proxy_pass http://127.0.0.1:43880;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-Proto https;
        # Never place upload request bodies in nginx temporary files.
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 310s;
        proxy_send_timeout 180s;
    }
    location / { return 404; }
}

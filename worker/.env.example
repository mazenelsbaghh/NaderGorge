# BullMQ Worker
# Local native Redis default. Docker compose uses redis:6379 internally; run `make docker-volumes` before first Docker start if external volumes are missing.
REDIS_URL=redis://localhost:6379
DB_CONNECTION_STRING=Host=localhost;Database=nadergorge;Username=postgres;Password=postgres

# AI Config — standard Gemini Developer API only.
AI_TEXT_MODEL=gemini-flash-latest
AI_IMAGE_MODEL=gemini-3-pro-image
# Required for transcription, chapters, mind maps, and live support.
GEMINI_API_KEY=CHANGE_ME_IN_LOCAL_ENV
# Optional: explicitly set ffmpeg path if not in the global PATH environment
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Webhook secret to hit the .NET API
API_CALLBACK_SECRET=CHANGE_ME_MIN_32_CHARS
AI_CALLBACK_SECRET=CHANGE_ME_MIN_32_CHARS
WORKER_ADMIN_TOKEN=CHANGE_ME_MIN_32_CHARS
SUBTITLE_STORAGE_PATH=.tmp/subtitles
PUBLIC_SUBTITLE_BASE_URL=/subtitles

# iOS APNs token-auth credentials. Leave empty when only Android/FCM is used.
# For local Debug builds use APNS_ENVIRONMENT=development; production builds use production.
APNS_KEY_ID=
APNS_TEAM_ID=CDZTQC2B3J
APNS_BUNDLE_ID=net.massaracademy.parent
APNS_ENVIRONMENT=development
# Either paste the .p8 contents with escaped newlines or point to a mounted file.
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_PATH=

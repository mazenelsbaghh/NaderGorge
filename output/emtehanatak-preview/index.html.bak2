<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>امتحاناتك | امتحانات أونلاين</title><meta name="theme-color" content="#0759C7">
<style>
@font-face{font-family:Alexandria;src:url(assets/Alexandria.ttf);font-weight:100 900;font-display:swap}500;600;700;800&display=swap');
*{box-sizing:border-box}body{margin:0;font:14px/1.8 Alexandria,Tahoma,sans-serif;background:oklch(.96 0 0);color:oklch(.24 0 0)}button,input,select,textarea{font:inherit}button,a,input,select,textarea{-webkit-tap-highlight-color:transparent}button{cursor:pointer}button:focus-visible,a:focus-visible{outline:3px solid var(--brand,orange);outline-offset:3px}button{transition:background .18s,transform .18s,color .18s}button:active{transform:scale(.97)}button:disabled{opacity:.45;cursor:default}h1,h2,h3,p{margin:0}h1,h2,h3{text-wrap:balance}h1{font-size:32px;line-height:1.5}h2{font-size:22px}h3{font-size:16px}small{font-size:12px}button{border:0}svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;vertical-align:middle;flex-shrink:0}.studio{background:oklch(.18 0 0);color:white;padding:19px 30px}.studio-top,.line{display:flex;align-items:center;justify-content:space-between;gap:14px}.studio small{color:oklch(.78 0 0)}.concepts{display:flex;gap:10px;margin-top:17px;flex-wrap:wrap}.concept{background:oklch(.25 0 0);color:white;padding:12px 18px;text-align:right;border-radius:10px;display:flex;gap:12px;align-items:center;flex:1;min-width:185px;border:1px solid transparent}.concept[aria-pressed=true]{border-color:oklch(.8 0 0);background:oklch(.32 0 0)}.swatches{display:flex;direction:ltr}.swatches i{display:block;width:15px;height:28px}.swatches i:first-child{border-radius:7px 0 0 7px}.swatches i:last-child{border-radius:0 7px 7px 0}.concept strong{font-size:16px}.concept span small{display:block}.toolbar{display:flex;align-items:center;gap:12px;padding:12px 30px;background:white;border-bottom:1px solid oklch(.89 0 0);flex-wrap:wrap}.toolbar select{padding:7px 10px;border:1px solid oklch(.8 0 0);border-radius:6px;background:white}.toolbar label{display:flex;align-items:center;gap:8px}.toolbar .caption{margin-inline-start:auto;color:oklch(.43 0 0);font-size:12px}.viewport{padding:24px;min-height:780px}.app{--bg:oklch(.985 0 0);--surface:oklch(1 0 0);--ink:oklch(.24 .025 75);--muted:oklch(.47 .02 75);--brand:oklch(.49 .12 75);--bright:oklch(.85 .15 80);--soft:oklch(.965 .035 80);--line:oklch(.89 .013 80);--inverse:white;--hero:oklch(.85 .15 80);--heroInk:oklch(.23 .035 75);--success:oklch(.41 .1 155);--danger:oklch(.46 .17 25);--radius:14px;max-width:1240px;margin:auto;background:var(--bg);color:var(--ink);border:1px solid var(--line);border-radius:16px;overflow:hidden;min-height:740px;display:grid;grid-template-columns:205px 1fr;position:relative}.app[data-theme=orbit]{--bg:oklch(.974 .008 255);--ink:oklch(.26 .06 255);--muted:oklch(.47 .035 255);--brand:oklch(.46 .18 255);--bright:oklch(.85 .08 255);--soft:oklch(.94 .025 255);--line:oklch(.88 .025 255);--hero:oklch(.36 .14 255);--heroInk:white;--radius:8px}.app[data-theme=pulse]{--bg:oklch(.17 .012 190);--surface:oklch(.22 .015 190);--ink:oklch(.96 .006 190);--muted:oklch(.76 .025 190);--brand:oklch(.86 .105 160);--bright:oklch(.79 .12 30);--soft:oklch(.28 .025 190);--line:oklch(.35 .02 190);--inverse:oklch(.18 .02 190);--hero:oklch(.86 .105 160);--heroInk:oklch(.18 .03 160);--success:oklch(.86 .105 160);--danger:oklch(.8 .12 30)}.sidebar{padding:25px 19px;background:var(--surface);border-inline-end:1px solid var(--line);display:flex;flex-direction:column;gap:22px}.brand{display:flex;align-items:center;gap:9px;font-size:25px;font-weight:800}.brand-mark{width:36px;height:36px;background:var(--brand);color:var(--inverse);display:grid;place-items:center;border-radius:10px}.sidebar nav{display:grid;gap:6px}.navbtn{display:flex;gap:10px;align-items:center;background:transparent;color:var(--muted);border-radius:8px;padding:12px;text-align:right}.navbtn.active{background:var(--soft);color:var(--brand);font-weight:600}.sidebar-foot{margin-top:auto;color:var(--muted);font-size:12px}.sidebar-foot strong{display:block;color:var(--ink)}.workspace{min-width:0}.appbar{padding:19px 30px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);background:var(--surface);gap:15px}.appbar .mobile-brand{display:none}.appbar small,.muted{color:var(--muted)}.avatar{display:grid;place-items:center;border-radius:50%;width:38px;height:38px;background:var(--soft);color:var(--brand);font-weight:600;flex-shrink:0}.iconbtn{background:transparent;color:var(--ink);min-width:44px;min-height:44px;border-radius:8px}.content{padding:27px 30px 35px;min-height:610px}.content.enter{animation:enter .28s cubic-bezier(.22,1,.36,1)}@keyframes enter{from{opacity:.6;transform:translateY(9px)}to{opacity:1;transform:none}}.page-title{margin-bottom:22px}.page-title p{color:var(--muted);margin-top:4px}.hero{padding:27px;background:var(--hero);color:var(--heroInk);border-radius:var(--radius);display:flex;justify-content:space-between;gap:20px;align-items:center;margin:22px 0}.hero p{margin:9px 0 18px;max-width:46ch}.hero h1{font-size:30px}.hero .btn{background:var(--heroInk);color:var(--hero)}.hero-art{width:150px;min-width:120px;align-self:stretch;display:flex;align-items:end;gap:9px;direction:ltr;padding:10px}.hero-art i{display:block;width:33%;background:currentColor;opacity:.8;border-radius:7px 7px 0 0}.hero-art i:nth-child(1){height:35%}.hero-art i:nth-child(2){height:65%}.hero-art i:nth-child(3){height:100%}.section-title{display:flex;align-items:center;justify-content:space-between;margin:24px 0 13px;gap:10px}.linkbtn{padding:8px 0;background:transparent;color:var(--brand);font-weight:500}.btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:12px 19px;min-height:46px;border-radius:9px;background:var(--brand);color:var(--inverse);font-weight:600}.btn.secondary{background:var(--soft);color:var(--ink)}.btn.full{width:100%}.row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.chips{display:flex;gap:8px;flex-wrap:wrap;margin:16px 0}.chip{padding:8px 16px;border:1px solid var(--line);background:var(--surface);color:var(--muted);border-radius:40px;min-height:42px}.chip.selected{background:var(--ink);color:var(--bg);border-color:var(--ink)}.teachers{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.teacher{padding:0;background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);text-align:right;color:var(--ink);overflow:hidden;transition:transform .2s}.teacher:hover{transform:translateY(-4px)}.portrait{height:123px;background:var(--soft);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}.portrait .initial{font-size:50px;font-weight:700;opacity:.35}.portrait .subject{position:absolute;bottom:9px;right:10px;background:var(--surface);color:var(--ink);padding:3px 10px;border-radius:5px;font-size:11px}.teacher-info{padding:12px 14px}.teacher-info small{display:block;color:var(--muted);margin-top:3px}.exam-row{display:flex;align-items:center;gap:15px;border-bottom:1px solid var(--line);padding:17px 0}.exam-icon{width:48px;height:53px;border-radius:9px;background:var(--soft);display:grid;place-items:center;color:var(--brand);flex-shrink:0}.exam-info{flex:1;min-width:0}.exam-info small{color:var(--muted)}.tag{font-size:11px;padding:3px 9px;background:var(--soft);color:var(--brand);border-radius:5px;display:inline-block}.columns{display:grid;grid-template-columns:1.3fr 1fr;gap:23px}.panel{background:var(--surface);padding:22px;border:1px solid var(--line);border-radius:var(--radius)}.panel p{margin:8px 0}.search{display:flex;align-items:center;gap:10px;background:var(--surface);border:1px solid var(--line);padding:10px 15px;border-radius:9px}.search input{border:0;background:transparent;color:var(--ink);width:100%;outline:none}.search:focus-within{outline:2px solid var(--brand)}.profile-cover{background:var(--hero);color:var(--heroInk);border-radius:var(--radius);padding:30px;display:flex;align-items:center;gap:20px}.profile-cover .avatar{width:90px;height:90px;font-size:35px;background:var(--surface)}.profile-cover h1{font-size:28px}.stats{display:flex;gap:25px;padding:20px 0;border-bottom:1px solid var(--line);margin-bottom:20px}.stats strong{font-size:24px;display:block}.stats small{color:var(--muted)}.progress{height:7px;border-radius:8px;background:var(--soft);overflow:hidden;margin:18px 0}.progress i{display:block;width:100%;height:100%;background:var(--brand);transform-origin:right;transition:transform .3s}.question{font-size:23px;line-height:1.9;margin:22px 0}.options{display:grid;gap:10px}.option{background:var(--surface);color:var(--ink);padding:15px;display:flex;align-items:center;gap:12px;border:1px solid var(--line);border-radius:9px;text-align:right}.option .letter{width:32px;height:32px;display:grid;place-items:center;background:var(--soft);border-radius:7px;flex-shrink:0}.option[aria-pressed=true]{border:2px solid var(--brand);padding:14px;background:var(--soft)}.option[aria-pressed=true] .letter{background:var(--brand);color:var(--inverse)}.question-map{display:flex;flex-wrap:wrap;gap:8px;margin:17px 0}.question-map button{width:40px;height:40px;border:1px solid var(--line);border-radius:7px;color:var(--ink);background:var(--surface)}.question-map button.done{background:var(--brand);color:var(--inverse)}.timer{font-variant-numeric:tabular-nums;color:var(--brand);font-size:20px}.result{text-align:center;max-width:550px;margin:10px auto}.score{width:170px;height:170px;border-radius:50%;border:10px solid var(--soft);margin:25px auto 20px;position:relative;display:grid;place-content:center}.score strong{font-size:47px;line-height:1.3}.score:after{content:'';position:absolute;inset:-10px;border:10px solid var(--brand);border-left-color:transparent;border-radius:50%;animation:ring .6s ease-out}@keyframes ring{from{transform:rotate(-150deg);opacity:0}to{transform:rotate(0);opacity:1}}.result .stats{justify-content:center}.form{max-width:480px;margin:auto}.field{display:grid;gap:7px;margin-bottom:17px}.field input,.field select,.field textarea{width:100%;padding:12px;background:var(--surface);border:1px solid var(--line);border-radius:8px;color:var(--ink)}.field textarea{resize:vertical;min-height:95px}.bottomnav{display:none}.chart{height:145px;display:flex;align-items:end;gap:12px;direction:ltr;border-bottom:1px solid var(--line);margin:30px 0 10px}.chart div{height:100%;flex:1;display:flex;align-items:end}.chart i{display:block;width:100%;background:var(--brand);border-radius:5px 5px 0 0;transform-origin:bottom;animation:grow .5s ease-out}@keyframes grow{from{transform:scaleY(0)}to{transform:scaleY(1)}}.notice{padding:14px;background:var(--soft);border-radius:8px;margin:15px 0;color:var(--ink)}.review-answer{padding:14px;border:1px solid var(--success);color:var(--success);border-radius:8px;margin:15px 0}.toast{position:fixed;bottom:30px;left:50%;transform:translateX(-50%);background:oklch(.22 0 0);color:white;padding:14px 22px;border-radius:10px;z-index:10;max-width:90vw}.theme-note{max-width:1240px;margin:17px auto;color:oklch(.4 0 0);font-size:12px}.app[data-theme=orbit] .hero{border-radius:0;margin-inline:-30px;padding-inline:30px}.app[data-theme=orbit] .teachers{grid-template-columns:1fr}.app[data-theme=orbit] .teacher{display:flex;border:0;border-bottom:1px solid var(--line);border-radius:0;align-items:center}.app[data-theme=orbit] .portrait{width:90px;height:85px;flex-shrink:0}.app[data-theme=orbit] .portrait .initial{font-size:32px}.app[data-theme=orbit] .portrait .subject{display:none}.app[data-theme=orbit] .teacher-info{flex:1}.app[data-theme=pulse] .hero-art{align-items:center}.app[data-theme=pulse] .hero-art i{border-radius:50%;height:45px!important}.app[data-theme=pulse] .hero-art i:nth-child(2){align-self:start;margin-top:20px}.app[data-theme=pulse] .hero-art i:nth-child(3){align-self:end;margin-bottom:15px}.app[data-theme=pulse] .portrait{background:var(--bright);color:oklch(.23 .02 30)}.app.mobile{max-width:410px;display:block}.app.mobile .sidebar{display:none}.app.mobile .mobile-brand{display:flex}.app.mobile .desktop-crumb{display:none}.app.mobile .appbar{padding:13px 17px}.app.mobile .content{padding:22px 18px}.app.mobile h1{font-size:26px}.app.mobile h2{font-size:19px}.app.mobile .hero{padding:22px 18px;margin-inline:0}.app.mobile .hero h1{font-size:25px}.app.mobile .hero-art{display:none}.app.mobile .teachers{gap:8px}.app.mobile .portrait{height:88px}.app.mobile .portrait .initial{font-size:34px}.app.mobile .teacher-info{padding:9px 7px}.app.mobile .teacher-info h3{font-size:12px}.app.mobile .teacher-info small{font-size:10px}.app.mobile .portrait .subject{font-size:10px;right:5px;bottom:5px;padding:1px 5px}.app.mobile .columns{grid-template-columns:1fr}.app.mobile .bottomnav{display:flex}.app.mobile .stats{gap:19px}.app.mobile .profile-cover{padding:20px 16px;gap:12px}.app.mobile .profile-cover h1{font-size:23px}.app.mobile .profile-cover .avatar{width:65px;height:65px}.bottomnav{background:var(--surface);border-top:1px solid var(--line);padding:8px;justify-content:space-around}.bottomnav button{display:flex;flex-direction:column;align-items:center;gap:3px;min-width:55px;min-height:48px;color:var(--muted);background:transparent;font-size:10px}.bottomnav button.active{color:var(--brand)}
@media(max-width:750px){.studio{padding:18px}.studio-top{align-items:start}.studio-top small{max-width:120px}.concepts{gap:6px}.concept{min-width:0;padding:10px 7px;display:block}.concept strong{font-size:14px}.concept small{display:none!important}.concept .swatches{margin-bottom:6px}.toolbar{padding:10px 15px}.toolbar .caption{display:none}.viewport{padding:12px 8px}.app{display:block}.sidebar{display:none}.appbar{padding:14px 18px}.appbar .mobile-brand{display:flex}.desktop-crumb{display:none}.content{padding:22px 18px}.columns{grid-template-columns:1fr}.hero{padding:22px 18px}.hero h1,h1{font-size:26px}.hero-art{display:none}.teachers{gap:8px}.teacher-info{padding:10px 7px}.teacher h3{font-size:12px}.teacher-info small{font-size:10px}.portrait{height:95px}.portrait .subject{font-size:10px;right:4px;padding:2px 5px}.bottomnav{display:flex}.app[data-theme=orbit] .hero{margin-inline:-18px;padding-inline:18px}.profile-cover{padding:20px 15px;gap:12px}.profile-cover h1{font-size:23px}.profile-cover .avatar{width:60px;height:60px;font-size:27px}.theme-note{padding:0 10px}.question{font-size:20px}.exam-row{gap:10px}.exam-row .btn{padding:10px;font-size:12px}.studio h3{font-size:15px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}

.preview-header{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:12px 30px;background:#102E52;color:#FFFFFF;font-size:12px}.preview-header a{display:block;background:white;border-radius:5px}.preview-header img{display:block;width:142px;height:52px}.wordmark{display:block;width:164px;height:auto}.login-logo{width:235px}.appbar .wordmark{width:158px}.sidebar .brand{margin-inline:-8px}.hero-art img{width:100%;height:auto}.hero-art{width:210px;align-items:center;padding:0}.app[data-theme=orbit]{--brand:#0759C7;--hero:#102E52;--ink:#102E52}.app.mobile .appbar{padding-block:6px}.bottomnav .navbtn.active{background:transparent}.app.mobile .bottomnav{position:sticky;bottom:0;z-index:2}.app .score{overflow:visible}.app .score:after{pointer-events:none}@media(max-width:750px){.preview-header{padding:10px 16px;gap:12px}.preview-header span{max-width:150px;font-size:10px}.preview-header img{width:125px}.appbar{padding-block:7px}.appbar .wordmark{width:148px}.bottomnav{position:sticky;bottom:0;z-index:2}}

/* Portrait-led teacher cards. */
.app[data-theme=orbit] .teachers{grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
.app[data-theme=orbit] .poster-teacher{display:block;padding:0;border:0;border-radius:14px;overflow:hidden;background:white;text-align:right;min-width:0;color:#102E52;transition:transform .22s cubic-bezier(.22,1,.36,1)}
.app[data-theme=orbit] .poster-teacher:hover{transform:translateY(-5px)}
.app[data-theme=orbit] .poster-teacher:focus-visible{outline:3px solid #0759C7;outline-offset:4px}
.app[data-theme=orbit] .poster-teacher .portrait{display:block;position:relative;width:100%;height:355px;background:#173B60;overflow:hidden}
.poster-teacher .portrait>img{width:100%;height:100%;display:block;object-fit:cover;object-position:center 20%;transition:transform .55s cubic-bezier(.22,1,.36,1)}
.poster-teacher:hover .portrait>img{transform:scale(1.045)}
.poster-teacher .portrait:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(5,24,44,.36) 0%,rgba(5,24,44,0) 34%,rgba(5,24,44,.18) 47%,rgba(5,24,44,.92) 100%);pointer-events:none}
.poster-top{position:absolute;inset:17px 17px auto;display:flex;align-items:center;justify-content:space-between;gap:10px;z-index:1}
.app[data-theme=orbit] .poster-teacher .portrait .subject{position:static;display:inline-flex;align-items:center;background:#FFFFFF;color:#0759C7;border-radius:7px;font-weight:600;font-size:12px;padding:5px 12px}
.poster-grade{color:#FFFFFF;font-size:11px;text-shadow:0 1px 3px #102E52}
.poster-title{position:absolute;inset:auto 22px 22px;z-index:1;color:#FFFFFF}
.teacher-prefix{font-size:12px;color:#E1EAF5;display:block;margin-bottom:3px}
.app[data-theme=orbit] .poster-teacher h3{font-size:29px;line-height:1.55;font-weight:800;color:#FFFFFF;letter-spacing:0}
.poster-caption{font-size:11px;color:#E1EAF5;display:block;margin-top:7px}
.poster-teacher .teacher-footer{padding:17px 16px;display:flex;justify-content:space-between;align-items:center;gap:8px;margin:0;border:0;background:#FFFFFF}
.exam-summary{display:flex;align-items:center;gap:8px;font-size:10px;line-height:1.6;color:#294565}
.poster-teacher .exam-count{font-size:29px;font-weight:700;line-height:1;letter-spacing:-1px;color:#102E52;font-variant-numeric:tabular-nums}
.exam-summary-sub{display:block;font-size:9px;color:#52647C;margin-top:2px}
.poster-teacher .teacher-cta{display:flex;align-items:center;gap:8px;color:#0759C7;font-size:11px;font-weight:600}
.cta-arrow{display:grid;place-items:center;width:35px;height:35px;border-radius:50%;background:#EAF2FF;color:#0759C7;transition:background .2s,color .2s}
.cta-arrow svg{width:18px;height:18px;transition:transform .2s}.poster-teacher:hover .cta-arrow{background:#0759C7;color:white}.poster-teacher:hover .cta-arrow svg{transform:translateX(-2px)}
.teacher-profile-photo{width:105px;height:120px;flex-shrink:0;border-radius:10px;overflow:hidden;background:var(--soft)}.teacher-profile-photo img{display:block;width:100%;height:100%;object-fit:cover;object-position:center 20%}
.app.mobile[data-theme=orbit] .teachers{grid-template-columns:1fr;gap:20px}.app.mobile[data-theme=orbit] .poster-teacher .portrait{height:365px}.app.mobile[data-theme=orbit] .poster-teacher h3{font-size:30px}.app.mobile[data-theme=orbit] .poster-teacher .teacher-footer{padding:18px 20px}.app.mobile .poster-teacher .teacher-cta{font-size:12px}
@media(max-width:750px){.app[data-theme=orbit] .teachers{grid-template-columns:1fr;gap:20px}.app[data-theme=orbit] .poster-teacher .portrait{height:365px}.app[data-theme=orbit] .poster-teacher h3{font-size:30px}.poster-teacher .teacher-footer{padding:18px 20px}.poster-teacher .teacher-cta{font-size:12px}.teacher-profile-photo{width:78px;height:95px}}
@media(prefers-reduced-motion:reduce){.app[data-theme=orbit] .poster-teacher,.poster-teacher .portrait>img,.cta-arrow,.cta-arrow svg{transition:none}.app[data-theme=orbit] .poster-teacher:hover,.poster-teacher:hover .portrait>img,.poster-teacher:hover .cta-arrow svg{transform:none}}

.teacher-hero{display:grid;grid-template-columns:1.2fr 1fr;background:#102E52;color:white;border-radius:14px;overflow:hidden;margin-top:14px;min-height:325px}.teacher-intro{padding:34px;align-self:center}.teacher-subject-label{font-size:12px;color:#CEE1FD}.teacher-honorific{font-size:14px;margin-top:24px;color:#CEE1FD}.teacher-intro h1{font-size:42px;font-weight:800;margin:0 0 12px}.teacher-intro-copy{max-width:34ch;color:#E7F0FC;font-size:13px;line-height:2}.follow-button{margin-top:23px;background:white;color:#0759C7;min-width:150px}.follow-button[aria-pressed=true]{background:#DCEAFF}.teacher-hero-image{position:relative;min-height:325px}.teacher-hero-image img{width:100%;height:100%;object-fit:cover;object-position:center 22%;position:absolute;inset:0}.teacher-hero-image:after{content:'';position:absolute;inset:0;background:linear-gradient(270deg,#102E52 0%,transparent 35%)}.teacher-promises{display:flex;justify-content:space-between;gap:16px;border-bottom:1px solid var(--line);padding:23px 0;color:var(--muted);font-size:12px;flex-wrap:wrap}.teacher-promises span{display:flex;align-items:center;gap:7px}.teacher-promises svg{width:18px;color:var(--brand)}.section-title p{font-size:12px;margin-top:5px}.exam-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.exam-card{background:white;border:1px solid var(--line);border-radius:12px;padding:19px;min-width:0;display:flex;flex-direction:column;transition:border-color .2s}.exam-card:hover{border-color:#0759C7}.exam-card-top{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:17px}.exam-level{font-size:10px;color:var(--muted)}.exam-card h3{font-size:19px;min-height:61px;line-height:1.7}.exam-owner{display:flex;align-items:center;gap:8px;margin:13px 0;color:var(--muted);font-size:11px}.exam-owner img{border-radius:50%;object-fit:cover;object-position:center 15%;flex-shrink:0}.exam-meta{display:flex;gap:16px;color:var(--muted);font-size:11px;margin:2px 0 19px}.exam-meta span{display:flex;align-items:center;gap:5px}.exam-meta svg{width:16px;height:16px}.exam-open{background:#EBF3FF;color:#0759C7;border-radius:7px;min-height:44px;padding:10px;display:flex;align-items:center;justify-content:space-between;font-size:12px;font-weight:600;margin-top:auto}.exam-open:hover{background:#0759C7;color:white}.exam-open svg{width:18px}.catalog-note{display:flex;align-items:center;gap:10px;padding:17px 0 23px;color:var(--muted);font-size:12px}.exam-detail-head{padding:20px 0 22px}.exam-detail-head h1{margin:14px 0 8px;max-width:26ch}.exam-detail-head .exam-owner{font-size:13px}.exam-start-panel{padding:26px;background:white;border:1px solid var(--line);border-radius:12px}.exam-start-panel>p{font-size:13px;margin-top:9px}.exam-facts{display:flex;justify-content:space-around;margin:27px 0}.exam-facts div{display:grid;justify-items:center;gap:4px}.exam-facts strong{font-size:29px}.exam-facts span{font-size:12px;color:var(--muted)}.exam-facts svg{color:var(--brand)}.exam-guidance{padding:25px 8px}.exam-guidance ol{padding-inline-start:22px;line-height:2.3;color:var(--muted);font-size:13px}.exam-guidance>p{font-size:12px}.columns .exam-grid{grid-template-columns:1fr}
.app.mobile .teacher-hero{grid-template-columns:1fr}.app.mobile .teacher-hero-image{grid-row:1;height:245px;min-height:245px}.app.mobile .teacher-hero-image:after{background:linear-gradient(0deg,#102E52,transparent 65%)}.app.mobile .teacher-intro{padding:0 23px 27px;position:relative}.app.mobile .teacher-honorific{margin-top:0}.app.mobile .teacher-intro h1{font-size:32px}.app.mobile .teacher-subject-label{display:inline-block;margin-bottom:10px}.app.mobile .exam-grid{grid-template-columns:1fr}.app.mobile .exam-card h3{min-height:0}.app.mobile .teacher-promises{font-size:11px;gap:10px}.app.mobile .section-title{align-items:start;flex-wrap:wrap}
@media(max-width:750px){.teacher-hero{grid-template-columns:1fr}.teacher-hero-image{grid-row:1;height:245px;min-height:245px}.teacher-hero-image:after{background:linear-gradient(0deg,#102E52,transparent 65%)}.teacher-intro{padding:0 23px 27px;position:relative}.teacher-honorific{margin-top:0}.teacher-intro h1{font-size:32px}.teacher-subject-label{display:inline-block;margin-bottom:10px}.exam-grid{grid-template-columns:1fr}.exam-card h3{min-height:0}.teacher-promises{font-size:11px;gap:10px}.section-title{align-items:start;flex-wrap:wrap}}
@media(prefers-reduced-motion:reduce){.exam-card{transition:none}}

.student-empty{text-align:center;padding:38px 20px;background:white;border-radius:12px}.empty-book{display:grid;place-items:center;margin:0 auto 18px;width:65px;height:65px;background:#EAF2FF;color:#0759C7;border-radius:50%}.empty-book svg{width:30px;height:30px}.student-empty h1{font-size:25px}.student-empty p{color:var(--muted);margin:12px auto 23px;max-width:40ch}.student-profile{display:flex;align-items:center;gap:17px;background:#102E52;color:white;border-radius:12px;padding:25px}.student-avatar{display:grid;place-items:center;width:67px;height:67px;background:#DDEBFF;color:#0759C7;border-radius:50%;font-size:29px}.student-profile p{font-size:12px;color:#DBE8FC}.student-profile>.tag{margin-inline-start:auto;background:#DDEBFF}.student-metrics,.result-breakdown{display:grid;grid-template-columns:repeat(3,1fr);padding:25px 0;border-bottom:1px solid var(--line);margin-bottom:22px}.student-metrics div,.result-breakdown div{text-align:center}.student-metrics strong,.result-breakdown strong{font-size:32px;display:block}.student-metrics span,.result-breakdown span{font-size:12px;color:var(--muted)}.resume-card{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:23px;background:#E6F0FF;border-radius:12px}.resume-card h3{margin:8px 0}.resume-card p{font-size:12px;color:var(--muted)}.attempt-list{background:white;border:1px solid var(--line);border-radius:12px;overflow:hidden}.attempt-row{display:flex;width:100%;align-items:center;gap:16px;padding:19px;background:white;text-align:right;color:var(--ink);border-bottom:1px solid var(--line)}.attempt-row:last-child{border-bottom:0}.attempt-row:hover{background:#F0F6FF}.attempt-percent{font-size:25px;font-weight:700;color:#0759C7;min-width:63px}.attempt-percent small{font-size:13px}.attempt-info{flex:1}.attempt-info strong{display:block;font-size:14px}.attempt-info small{display:block;font-size:11px;color:var(--muted);margin-top:5px}.attempt-view{display:flex;align-items:center;gap:8px;color:#0759C7;font-size:12px}.attempt-view svg{width:18px}.local-note{font-size:12px;color:var(--muted);margin-top:22px}.result-new>h1{margin-top:16px}.result-new .score{margin-top:28px}.result-actions{display:flex;justify-content:center;gap:10px;margin-top:14px}.next-step{padding:15px 0 22px}.next-step p{font-size:13px;color:var(--muted);margin-top:6px}.review-list{display:grid;gap:19px;margin:22px 0}.review-card{padding:23px;border:1px solid var(--line);background:white;border-radius:12px}.review-header{display:flex;justify-content:space-between;gap:10px;font-size:12px;color:var(--muted);margin-bottom:16px}.answer-status{border-radius:5px;padding:3px 8px}.correct{background:#E8F5EE;color:#185338}.incorrect{background:#FFF0EC;color:#8C3326}.review-card h3{font-size:19px;line-height:1.9}.your-answer{margin-top:20px;padding:13px 16px;background:#F0F4F9;border-radius:7px;display:grid;gap:4px}.your-answer span{color:var(--muted);font-size:11px}.your-answer strong{font-size:14px;font-weight:500}.explanation{margin-top:18px}.explanation h4{margin:0 0 5px;color:#0759C7}.explanation p{font-size:14px;color:var(--muted);line-height:2}
.app.mobile .resume-card{align-items:stretch;flex-direction:column}.app.mobile .student-profile{padding:20px 15px}.app.mobile .student-avatar{width:48px;height:48px}.app.mobile .attempt-row{padding:16px 12px;gap:9px}.app.mobile .attempt-view{font-size:0}.app.mobile .result-actions{flex-wrap:wrap}.app.mobile .student-metrics span{font-size:10px}
@media(max-width:750px){.resume-card{align-items:stretch;flex-direction:column}.student-profile{padding:20px 15px}.student-avatar{width:48px;height:48px}.attempt-row{padding:16px 12px;gap:9px}.attempt-view{font-size:0}.result-actions{flex-wrap:wrap}.student-metrics span{font-size:10px}.review-card{padding:18px}}
.result-new .score{border-color:transparent}.result-new .score:after{display:none}.score-ring{position:absolute;inset:-10px;width:170px;height:170px;pointer-events:none}

.admin-welcome{display:flex;align-items:center;justify-content:space-between;gap:25px;background:#102E52;color:white;padding:27px;border-radius:12px}.admin-welcome p{font-size:12px;color:#DCEAFF;margin-top:8px}.admin-welcome .btn{background:white;color:#0759C7;flex-shrink:0}.admin-list{background:white;border:1px solid var(--line);border-radius:12px;overflow:hidden}.admin-exam-row{display:flex;align-items:center;gap:16px;padding:18px;border-bottom:1px solid var(--line)}.admin-exam-row:last-child{border:0}.admin-exam-row>div{flex:1;min-width:0}.admin-exam-row h3{font-size:15px;overflow-wrap:anywhere}.admin-exam-row small{color:var(--muted);font-size:11px}.admin-exam-row .btn{font-size:12px;padding:10px 14px}.admin-status,.admin-subject{font-size:11px;padding:5px 9px;border-radius:5px;min-width:58px;text-align:center;background:#EAF2FF;color:#0759C7}.admin-status{background:#FFF0D7;color:#715018}.admin-empty{background:white;border-radius:12px;padding:25px;color:var(--muted);font-size:13px}.editor-basics{display:grid;grid-template-columns:1.5fr 1fr;gap:20px;padding:22px;background:white;border:1px solid var(--line);border-radius:12px}.editor-basics .field{margin:0}.editor-question-list{display:grid;gap:24px;margin:26px 0}.editor-question{margin:0;min-width:0;background:white;border:1px solid var(--line);padding:23px;border-radius:12px}.editor-question legend{font-weight:600;color:#0759C7;padding:0 10px}.editor-question .field:last-child{margin-bottom:0}.editor-options{display:grid;grid-template-columns:1fr 1fr;gap:0 18px}.editor-question textarea{min-height:80px}.editor-publish{display:flex;justify-content:space-between;align-items:center;gap:20px;background:#EAF2FF;padding:23px;border-radius:12px}.editor-publish p{font-size:12px;color:var(--muted);margin-top:5px;max-width:42ch}.editor-publish .row{flex-shrink:0}.exam-card h3,.review-card h3,.your-answer strong,.explanation p{overflow-wrap:anywhere}.exam-card h3{word-break:normal}
.app.mobile .admin-welcome,.app.mobile .editor-publish{flex-direction:column;align-items:stretch}.app.mobile .editor-basics,.app.mobile .editor-options{grid-template-columns:1fr}.app.mobile .admin-exam-row{flex-wrap:wrap;gap:10px;padding:15px}.app.mobile .admin-exam-row>.btn{margin-inline-start:auto}.app.mobile .editor-question{padding:17px}
@media(max-width:750px){.admin-welcome,.editor-publish{flex-direction:column;align-items:stretch}.editor-basics,.editor-options{grid-template-columns:1fr}.admin-exam-row{flex-wrap:wrap;gap:10px;padding:15px}.admin-exam-row>.btn{margin-inline-start:auto}.editor-question{padding:17px}}

/* ─── Impeccable Exam Experience (Mobile & Web) ─── */
html, body {
  max-width: 100%;
  overflow-x: hidden;
}
.app.in-exam-screen {
  grid-template-columns: 1fr !important;
  background: #0A1D3D !important;
  border-color: #1E293B !important;
}
.app.in-exam-screen .sidebar,
.app.in-exam-screen .appbar,
.app.in-exam-screen .bottomnav {
  display: none !important;
}
.app.in-exam-screen .workspace {
  background: #F8FAFC !important;
  display: flex !important;
  flex-direction: column !important;
  min-height: 740px !important;
  width: 100% !important;
}
.app.in-exam-screen .content {
  padding: 0 !important;
  display: flex !important;
  flex-direction: column !important;
  flex: 1 !important;
  width: 100% !important;
}

/* Exam App Bar */
.exam-header {
  background: #0A1D3D;
  color: #FFFFFF;
  padding: 14px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  position: sticky;
  top: 0;
  z-index: 25;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  box-sizing: border-box;
  width: 100%;
}
.exam-brand-area {
  display: flex;
  align-items: center;
  gap: 8px;
}
.exam-brand-logo {
  height: 24px;
  width: auto;
  filter: brightness(0) invert(1);
}
.exam-counter-chip {
  background: rgba(255, 255, 255, 0.12);
  color: #FFFFFF;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 99px;
  padding: 6px 16px;
  font-size: 13px;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  transition: all 0.18s;
}
.exam-counter-chip:hover {
  background: rgba(255, 255, 255, 0.22);
}
.exam-timer-chip {
  background: #D97706; /* High-contrast orange/amber */
  color: #FFFFFF;
  border-radius: 8px;
  padding: 6px 14px;
  font-weight: 800;
  font-size: 14px;
  letter-spacing: 0.5px;
  font-variant-numeric: tabular-nums;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  box-shadow: 0 2px 8px rgba(217, 119, 6, 0.3);
}

/* Progress sub-bar */
.exam-progress-wrap {
  background: #0E2448;
  padding: 8px 20px 10px;
  display: flex;
  align-items: center;
  gap: 12px;
  direction: ltr;
  box-sizing: border-box;
  width: 100%;
}
.exam-progress-bar-bg {
  flex: 1;
  height: 6px;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 99px;
  overflow: hidden;
}
.exam-progress-bar-fill {
  height: 100%;
  background: #0E8F8F;
  border-radius: 99px;
  transition: width 0.25s ease;
}
.exam-progress-pct {
  color: #94A3B8;
  font-size: 11px;
  font-weight: 700;
  min-width: 32px;
  text-align: right;
}

/* Exam Content Layout */
.exam-screen-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 16px 20px 24px;
  max-width: 1080px;
  margin: 0 auto;
  width: 100%;
  box-sizing: border-box;
}
.app:not(.mobile) .exam-screen-body {
  display: grid;
  grid-template-columns: 1fr 310px;
  gap: 24px;
  align-items: start;
}

/* Question Main Card */
.exam-card-surface {
  background: #FFFFFF;
  border: 1px solid #E2E8F0;
  border-radius: 20px;
  padding: 22px 20px;
  box-shadow: 0 4px 20px rgba(10, 29, 61, 0.04);
  display: flex;
  flex-direction: column;
  gap: 16px;
  box-sizing: border-box;
  width: 100%;
}
.exam-question-title {
  font-size: 16px;
  line-height: 1.8;
  font-weight: 700;
  color: #0A1D3D;
  margin: 0;
}

/* Diagram Box & SVG Overrides */
.exam-diagram-box {
  background: #F8FAFC;
  border: 1px solid #E2E8F0;
  border-radius: 14px;
  padding: 14px 12px;
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
}
.exam-diagram-box svg.circuit-diagram-svg {
  width: 100% !important;
  height: auto !important;
  max-width: 440px !important;
  max-height: 200px !important;
  display: block !important;
  margin: 0 auto !important;
}
.exam-diagram-box svg.circuit-diagram-svg text {
  fill: #0F172A !important;
  stroke: none !important;
  font-family: Alexandria, Tahoma, sans-serif !important;
  font-size: 13px !important;
  font-weight: 700 !important;
}
.exam-diagram-box svg.circuit-diagram-svg circle {
  fill: #1E293B !important;
  stroke: none !important;
}
.exam-diagram-box svg.circuit-diagram-svg polygon {
  fill: #0E8F8F !important;
  stroke: none !important;
}
.exam-diagram-box svg.circuit-diagram-svg line {
  stroke: #1E293B !important;
}
.exam-diagram-box svg.circuit-diagram-svg path {
  stroke: #1E293B !important;
  fill: none !important;
}
.exam-diagram-box svg.circuit-diagram-svg .teal-circuit {
  stroke: #0E8F8F !important;
  fill: #0E8F8F !important;
}

/* Option Buttons */
.exam-options-stack {
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: 100%;
  box-sizing: border-box;
}
.exam-option-btn {
  background: #FFFFFF;
  border: 1.5px solid #E2E8F0;
  border-radius: 14px;
  padding: 14px 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  cursor: pointer;
  text-align: right;
  font-size: 15px;
  font-weight: 600;
  color: #1E293B;
  transition: all 0.18s ease;
  min-height: 52px;
  box-sizing: border-box;
  width: 100%;
}
.exam-option-btn:hover {
  border-color: #CBD5E1;
  background: #F8FAFC;
}
.exam-option-btn.selected {
  border-color: #0E8F8F !important;
  background: #F0FDF9 !important;
  color: #0F766E !important;
  box-shadow: 0 0 0 1px #0E8F8F;
}
.exam-option-btn .check-circle {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  border: 1.5px solid #CBD5E1;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  transition: all 0.2s ease;
}
.exam-option-btn.selected .check-circle {
  background: #0E8F8F;
  border-color: #0E8F8F;
  color: #FFFFFF;
}

/* Sticky Bottom Bar */
.exam-sticky-bar {
  background: #0A1D3D;
  padding: 12px 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  position: sticky;
  bottom: 0;
  z-index: 25;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  margin-top: auto;
  box-sizing: border-box;
  width: 100%;
}
.exam-action-btn {
  border-radius: 10px;
  padding: 10px 14px;
  font-weight: 700;
  font-size: 13px;
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  cursor: pointer;
  transition: all 0.2s;
  min-height: 46px;
  flex: 1;
  box-sizing: border-box;
}
.exam-action-btn.prev {
  background: #0A1D3D;
  color: #2DD4BF;
  border: 1.5px solid #0E8F8F;
}
.exam-action-btn.prev:hover:not(:disabled) {
  background: rgba(14, 143, 143, 0.18);
}
.exam-action-btn.flag {
  background: #0E8F8F;
  color: #FFFFFF;
  border: 1.5px solid #0E8F8F;
}
.exam-action-btn.flag:hover {
  background: #0C7A7A;
}
.exam-action-btn.flag.active {
  background: #D97706;
  border-color: #D97706;
  color: #FFFFFF;
}
.exam-action-btn.next {
  background: #0E8F8F;
  color: #FFFFFF;
  border: 1.5px solid #0E8F8F;
}
.exam-action-btn.next:hover {
  background: #0C7A7A;
}

/* Question Map (Side card on Desktop) */
.exam-map-panel {
  background: #FFFFFF;
  border: 1px solid #E2E8F0;
  border-radius: 20px;
  padding: 20px;
  box-shadow: 0 4px 20px rgba(10, 29, 61, 0.04);
  position: sticky;
  top: 80px;
  box-sizing: border-box;
}
.exam-map-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}
.exam-map-head h3 {
  font-size: 16px;
  font-weight: 800;
  color: #0A1D3D;
  margin: 0;
}
.exam-legend-row {
  display: flex;
  gap: 10px;
  font-size: 11px;
  color: #64748B;
  margin-bottom: 16px;
  flex-wrap: wrap;
}
.exam-legend-row span {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}
.exam-legend-row .dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}
.dot.ans { background: #0E8F8F; }
.dot.flg { background: #D97706; }
.dot.un { background: #CBD5E1; }

.exam-bubbles-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8px;
}
.exam-q-bubble {
  aspect-ratio: 1;
  border-radius: 12px;
  font-size: 13px;
  font-weight: 700;
  border: 1.5px solid #E2E8F0;
  background: #F8FAFC;
  color: #475569;
  display: grid;
  place-items: center;
  cursor: pointer;
  transition: all 0.15s;
}
.exam-q-bubble.current {
  border-color: #0A1D3D;
  outline: 2px solid #0A1D3D;
  font-weight: 900;
}
.exam-q-bubble.answered {
  background: #0E8F8F;
  color: #FFFFFF;
  border-color: #0E8F8F;
}
.exam-q-bubble.flagged {
  background: #D97706;
  color: #FFFFFF;
  border-color: #D97706;
}

/* Mobile responsive fixes */
.preview-header {
  box-sizing: border-box;
  max-width: 100%;
}
.toolbar {
  box-sizing: border-box;
  max-width: 100%;
}
@media (max-width: 600px) {
  .preview-header,
  .toolbar {
    display: none !important;
  }
  .viewport {
    padding: 0 !important;
    margin: 0 !important;
    width: 100vw !important;
    max-width: 100vw !important;
  }
  .app, .app.mobile {
    max-width: 100vw !important;
    width: 100vw !important;
    border-radius: 0 !important;
    border: none !important;
    margin: 0 !important;
  }
  .exam-header {
    padding: 12px 14px !important;
  }
  .exam-progress-wrap {
    padding: 8px 14px 10px !important;
  }
  .exam-screen-body {
    padding: 12px 12px 20px !important;
  }
  .exam-card-surface {
    padding: 16px 14px !important;
    border-radius: 16px !important;
  }
  .exam-sticky-bar {
    padding: 10px 12px !important;
    gap: 6px !important;
  }
  .exam-action-btn {
    padding: 8px 6px !important;
    font-size: 12px !important;
    min-height: 44px !important;
  }
}
.app.mobile .exam-map-panel {
  display: none !important;
}
@media (max-width: 850px) {
  .exam-map-panel {
    display: none !important;
  }
}

/* Mobile Bottom Sheet Drawer */
.exam-mobile-sheet-overlay {
  position: fixed;
  inset: 0;
  background: rgba(10, 29, 61, 0.65);
  backdrop-filter: blur(4px);
  z-index: 99;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.22s ease;
}
.exam-mobile-sheet-overlay.open {
  opacity: 1;
  pointer-events: auto;
}
.exam-mobile-sheet {
  background: #FFFFFF;
  width: 100%;
  max-width: 440px;
  border-radius: 24px 24px 0 0;
  padding: 24px;
  max-height: 82vh;
  overflow-y: auto;
  transform: translateY(100%);
  transition: transform 0.25s cubic-bezier(0.2, 0.9, 0.3, 1);
  display: flex;
  flex-direction: column;
  gap: 16px;
  box-sizing: border-box;
}
.exam-mobile-sheet-overlay.open .exam-mobile-sheet {
  transform: translateY(0);
}
.exam-sheet-close {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #F1F5F9;
  display: grid;
  place-items: center;
  font-size: 18px;
  cursor: pointer;
  border: 0;
}

</style>
</head>
<body>
<header class="preview-header"><a href="assets/logo.svg" download><img src="assets/logo.svg" alt="امتحاناتك"></a><span>معاينة التصميم المعتمد · بيانات تجريبية</span></header>
<div class="toolbar"><label>الصفحة <select id="pageSelect" aria-label="اختر الصفحة"></select></label><label>العرض <select id="device"><option value="desktop">واسع</option><option value="mobile" selected>موبايل</option></select></label><span class="caption">جرّب التنقّل، اختيار الإجابات، وتسليم الامتحان</span></div>
<div class="viewport"><div class="app mobile" id="app" data-theme="orbit"><aside class="sidebar" id="sidebar"></aside><div class="workspace"><header class="appbar" id="appbar"></header><main class="content" id="content"></main><nav class="bottomnav" id="bottomnav" aria-label="التنقل الرئيسي"></nav></div></div><p class="theme-note" id="themeNote"></p></div>
<div id="live" aria-live="polite"></div>
<script>
const icons={home:'<path d="m3 10 9-7 9 7v10H3Z"/><path d="M9 20v-7h6v7"/>',users:'<circle cx="9" cy="8" r="3"/><path d="M3 20v-3a6 6 0 0 1 12 0v3M16 5a3 3 0 0 1 0 6m2 3a5 5 0 0 1 3 5"/>',book:'<path d="M4 4h7l1 2 1-2h7v16h-7l-1 1-1-1H4ZM12 6v15"/>',user:'<circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/>',bell:'<path d="M5 17h14l-2-4V8a5 5 0 0 0-10 0v5ZM10 21h4"/>',arrow:'<path d="M20 12H4m6-6-6 6 6 6"/>',search:'<circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/>',check:'<path d="m5 12 4 4L20 5"/>',clock:'<circle cx="12" cy="12" r="9"/><path d="M12 6v6l4 2"/>',settings:'<path d="M4 7h16M4 17h16"/><circle cx="8" cy="7" r="3"/><circle cx="16" cy="17" r="3"/>',bolt:'<path d="m13 2-9 12h7l-1 8 10-13h-8Z"/>'};
const icon=n=>`<svg viewBox="0 0 24 24" aria-hidden="true">${icons[n]||icons.book}</svg>`;
const themes={spark:{name:'ومضة',desc:'عنبري • أبيض • حبر',colors:['oklch(.85 .15 80)','white','oklch(.24 .025 75)'],headline:'كل امتحان، خطوة لقدّام.',sub:'اختار مدرسك، جرّب مستواك، وادخل امتحانك الجاي بثقة.',note:'ومضة: بطاقات مدرسين واضحة وألوان دافئة على خلفية بيضاء. انتقالات قصيرة، وتأكيد مرئي عند اختيار الإجابة.'},orbit:{name:'امتحاناتك',desc:'أزرق • سماوي • أبيض',colors:['oklch(.46 .18 255)','oklch(.85 .08 255)','white'],headline:'امتحانك الجاي يبدأ هنا.',sub:'امتحانات منظمة حسب مدرسك ومنهجك. ابدأ من النقطة اللي محتاج تقوّيها.',note:'مدار: قوائم مرتبة ومساحات هادئة. أزرق عميق للعناوين، انتقالات ناعمة، وشريط تقدّم يتحرك مع كل إجابة.'},pulse:{name:'نبض',desc:'فحمي • نعناعي • مرجاني',colors:['oklch(.22 .015 190)','oklch(.86 .105 160)','oklch(.79 .12 30)'],headline:'جاهز تتحدّى نفسك؟',sub:'جولة جديدة من الأسئلة. ركّز، جاوب، واكتشف التقدّم اللي حققته.',note:'نبض: تجربة داكنة للمذاكرة بالليل، ولمسات نعناعي ومرجاني. حركة لعرض النتيجة واستجابة سريعة للضغط؛ الامتحان يفضل هادي.'}};
const pages={home:'الرئيسية',teachers:'كل المدرسين',teacher:'صفحة المدرس',exams:'الامتحانات',details:'قبل الامتحان',exam:'حل الامتحان',result:'النتيجة',review:'مراجعة الإجابات',profile:'حسابي وتقدّمي',login:'تسجيل الدخول',admin:'لوحة الإدارة',editor:'إضافة امتحان'};
const people=[{name:'أحمد حسن',initial:'أح',photo:'assets/teacher-ahmed.jpg',subject:'فيزياء',count:18},{name:'سارة عادل',initial:'سع',photo:'assets/teacher-sara.jpg',subject:'كيمياء',count:24},{name:'عمر نبيل',initial:'عن',photo:'assets/teacher-omar.jpg',subject:'رياضيات',count:16}];
const circuitSvg = `<svg class="circuit-diagram-svg" viewBox="0 0 440 220" width="100%" height="190" xmlns="http://www.w3.org/2000/svg">
  <!-- Left Wire & 24V Battery -->
  <line x1="65" y1="40" x2="65" y2="92" stroke="#1E293B" stroke-width="2.5" stroke-linecap="round"/>
  <line x1="47" y1="92" x2="83" y2="92" stroke="#1E293B" stroke-width="3" stroke-linecap="round"/>
  <line x1="55" y1="102" x2="75" y2="102" stroke="#1E293B" stroke-width="2" stroke-linecap="round"/>
  <text x="36" y="99" font-size="13" font-weight="700" fill="#0F172A" text-anchor="end" direction="ltr">24 V</text>
  <line x1="65" y1="102" x2="65" y2="180" stroke="#1E293B" stroke-width="2.5" stroke-linecap="round"/>

  <!-- Top Wire & R1 = 6 ohm -->
  <line x1="65" y1="40" x2="110" y2="40" stroke="#1E293B" stroke-width="2.5" stroke-linecap="round"/>
  <path d="M 110 40 l 7 -10 l 14 20 l 14 -20 l 14 20 l 14 -20 l 7 10" fill="none" stroke="#1E293B" stroke-width="2.5" stroke-linejoin="round"/>
  <text x="145" y="20" font-size="13" font-weight="700" fill="#0F172A" text-anchor="middle" direction="ltr">R₁ = 6Ω</text>
  <line x1="180" y1="40" x2="220" y2="40" stroke="#1E293B" stroke-width="2.5" stroke-linecap="round"/>
  
  <!-- Top Node -->
  <circle cx="220" cy="40" r="4" fill="#1E293B"/>

  <!-- Top Right Battery E -->
  <line x1="220" y1="40" x2="275" y2="40" stroke="#1E293B" stroke-width="2.5" stroke-linecap="round"/>
  <line x1="275" y1="26" x2="275" y2="54" stroke="#1E293B" stroke-width="3" stroke-linecap="round"/>
  <line x1="283" y1="32" x2="283" y2="48" stroke="#1E293B" stroke-width="2" stroke-linecap="round"/>
  <text x="279" y="18" font-size="13" font-weight="700" fill="#0F172A" text-anchor="middle">E</text>
  <line x1="283" y1="40" x2="355" y2="40" stroke="#1E293B" stroke-width="2.5" stroke-linecap="round"/>

  <!-- Right Branch & R3 = 8 ohm -->
  <line x1="355" y1="40" x2="355" y2="82" stroke="#1E293B" stroke-width="2.5" stroke-linecap="round"/>
  <path d="M 355 82 l -10 6 l 20 12 l -20 12 l 20 12 l -20 12 l 10 6" fill="none" stroke="#1E293B" stroke-width="2.5" stroke-linejoin="round"/>
  <text x="405" y="115" font-size="13" font-weight="700" fill="#0F172A" text-anchor="start" direction="ltr">R₃ = 8Ω</text>
  <line x1="355" y1="142" x2="355" y2="180" stroke="#1E293B" stroke-width="2.5" stroke-linecap="round"/>

  <!-- Center Branch & R2 = 4 ohm -->
  <line x1="220" y1="40" x2="220" y2="80" stroke="#1E293B" stroke-width="2.5" stroke-linecap="round"/>
  <path d="M 220 80 l -10 6 l 20 12 l -20 12 l 20 12 l -20 12 l 10 6" fill="none" stroke="#1E293B" stroke-width="2.5" stroke-linejoin="round"/>
  <text x="175" y="115" font-size="13" font-weight="700" fill="#0F172A" text-anchor="end" direction="ltr">R₂ = 4Ω</text>
  <line x1="220" y1="140" x2="220" y2="180" stroke="#1E293B" stroke-width="2.5" stroke-linecap="round"/>
  
  <!-- Current Arrow I (Teal) -->
  <line x1="244" y1="92" x2="244" y2="128" stroke="#0E8F8F" stroke-width="2.2" stroke-linecap="round" class="teal-circuit"/>
  <polygon points="240,126 248,126 244,136" fill="#0E8F8F" class="teal-circuit"/>
  <text x="256" y="115" font-size="14" font-weight="800" fill="#0E8F8F" text-anchor="start" class="teal-circuit">I</text>

  <!-- Bottom Node & Wire -->
  <circle cx="220" cy="180" r="4" fill="#1E293B"/>
  <line x1="65" y1="180" x2="355" y2="180" stroke="#1E293B" stroke-width="2.5" stroke-linecap="round"/>
</svg>`;
const physicsQuestions=[
{q:'إذا تضاعفت شدة التيار في موصل مع ثبات مقاومته، فإن فرق الجهد بين طرفيه…',o:['يقل إلى النصف','يتضاعف','يظل ثابتًا','يصبح أربعة أمثال'],a:1,why:'من قانون أوم: فرق الجهد = شدة التيار × المقاومة. مع ثبات المقاومة، يتضاعف فرق الجهد عند تضاعف التيار.'},
{q:'موصل مقاومته ٤ أوم يمر به تيار شدته ٣ أمبير. ما فرق الجهد بين طرفيه؟',o:['١٢ فولت','٧ فولت','١ فولت','٢٤ فولت'],a:0,why:'بتطبيق قانون أوم: V = I × R = 3 × 4 = 12 فولت.'},
{q:'ما وحدة قياس المقاومة الكهربائية؟',o:['الأمبير','الفولت','الأوم','الوات'],a:2,why:'تقاس المقاومة بالأوم، بينما تقاس شدة التيار بالأمبير وفرق الجهد بالفولت.'},
{q:'ما وحدة قياس المقاومة النوعية لمادة موصل؟',o:['أوم','أوم · متر','أوم / متر','فولت / أمبير'],a:1,why:'المقاومة النوعية تقاس بوحدة (أوم · متر).'},
{q:'عند توصيل عدة مقاومات متساوية على التوازي، فإن المقاومة المكافئة تكون…',o:['أكبر من أكبر مقاومة','أصغر من أصغر مقاومة','مساوية لمجموعها','تساوي متوسطها'],a:1,why:'التوصيل على التوازي يقلل المقاومة الكلية لتكون أصغر من أصغر مقاومة فردية.'},
{q:'القانون الأول لكيرشوف يعبر فيزيائيًا عن مبدأ حفظ…',o:['الطاقة','الشحنة الكهربية','كمية الحركة','الكتلة'],a:1,why:'قانون كيرشوف الأول يعبر عن حفظ الشحنة الكهربية: مجموع التيارات الداخلة = الخارجة.'},
{q:'سلكان من نفس المادة، طول الثاني ضعف طول الأول وقطره ضعف قطر الأول، فإن نسبة مقاومة الأول إلى الثاني…',o:['1 : 1','2 : 1','1 : 2','4 : 1'],a:1,why:'R ∝ L / A = L / r²، وبالتالي نسبة R₁ إلى R₂ تساوي 2 : 1.'},
{q:'القوة الدافعة الكهربية للعمود الكهربي تقاس بوحدة…',o:['الأمبير','الجول','الفولت','الكولوم'],a:2,why:'القوة الدافعة الكهربية هي فرق الجهد بين قطبي المصدر في الدائرة المفتوحة وتقاس بالفولت.'},
{q:'عند زيادة طول سلك إلى الضعف مع ثبات حجمه، فإن مقاومته…',o:['تزداد للضعف','تزداد لأربعة أمثالها','تقل للنصف','تظل ثابتة'],a:1,why:'بثبوت الحجم إذا تضاعف الطول قل نصف القطر ومساحة المقطع للنصف، فتزداد المقاومة 4 أمثال.'},
{q:'جهاز يستخدم لقياس شدة التيارات الكهربية الضعيفة جدًا هو…',o:['الأميتر ذو الملف المتحرك','الجلفانومتر الحساس','الفولتميتر','الأوميتر'],a:1,why:'الجلفانومتر ذو الملف المتحرك مصمم للاستدلال وقياس التيارات الضعيفة جدًا.'},
{q:'في قانون أوم للدائرة المغلقة: V = VB - I.r، إذا زادت المقاومة الخارجية، فإن قراءة الفولتميتر بين قطبي البطارية…',o:['تقل','تزداد','تظل ثابتة','تصبح صفرًا'],a:1,why:'بزيادة المقاومة الخارجية يقل التيار الكلي I، فيقل المقدار (I.r) وبالتالي يزداد فرق الجهد V بين القطبين.'},
{q:'ما وظيفة مجزئ التيار في الأميتر؟',o:['زيادة حساسية الجهاز','إنقاص مقاومة الجهاز الكلية لزيادة مدى قياسه','زيادة مقاومة الجهاز','حماية المؤشر من الكسر فقط'],a:1,why:'مجزئ التيار مقاومة صغيرة على التوازي تجعل المقاومة الكلية صغيرة جداً وتزيد مدى التيارات المقاسة.'},
{q:'مقاومة موصل تتناسب عكسيًا مع…',o:['طول الموصل','مساحة مقطعه العرضي','درجة حرارته','نوع مادته'],a:1,why:'R = ρ.L/A تتناسب عكسياً مع مساحة المقطع العرضي A.'},
{q:'في الدائرة الكهربائية الموضحة أدناه، إذا كان فرق الجهد بين طرفي المقاومة R₃ هو 12 فولت، فما هي قيمة شدة التيار الكهربائي (I) المار في المقاومة R₂؟',diagram:'circuit',o:['1.5 أمبير','2.0 أمبير','2.5 أمبير','3.0 أمبير'],a:1,why:'من قانون أوم: تيار المقاومة R₃ هو I₃ = 12 / 8 = 1.5A، وبتطبيق قوانين الدوائر نجد أن شدة التيار المار في R₂ تساوي 2.0 أمبير.'},
{q:'قاعدة فليمنج لليد اليسرى تستخدم في تحديد…',o:['اتجاه المجال المغناطيسي','اتجاه التيار المستحث','اتجاه القوة المغناطيسية المؤثرة على سلك يمر به تيار','اتجاه الشحنات الموجبة'],a:2,why:'تستخدم قاعدة فليمنج لليد اليسرى لتحديد اتجاه القوة والحركة المؤثرة على سلك يمر به تيار في مجال مغناطيسي.'},
{q:'قاعدة البريمة اليمنى لماكسويل تستخدم في تحديد…',o:['اتجاه خطوط الفيض المغناطيسي لتيار يمر في سلك مستقيم','اتجاه القوة المؤثرة','اتجاه التيار المستحث','مقدار الفيض المغناطيسي'],a:0,why:'تستخدم قاعدة البريمة اليمنى لتحديد اتجاه خطوط الفيض المغناطيسي حول سلك مستقيم.'},
{q:'كثافة الفيض المغناطيسي عند مركز ملف دائري تتناسب طرديًا مع…',o:['نصف قطر الملف','عدد لفات الملف وشدة التيار','مقاومة السلك فقط','مساحة المقطع العرضي'],a:1,why:'B = μ.N.I / (2r)، تتناسب طردياً مع N و I وعكسياً مع r.'},
{q:'عزم الازدواج المغناطيسي المؤثر على ملف يمر به تيار موضوع في مجال مغناطيسي ينعدم عندما يكون…',o:['مستوى الملف موازيًا لخطوط الفيض','مستوى الملف عموديًا على خطوط الفيض','مستوى الملف مائلًا بزاوية 45°','التيار في أقصى قيمة له'],a:1,why:'ينعدم عزم الازدواج عندما يكون مستوى الملف عمودياً على خطوط المجال لأن الزاوية بين العمودي على الملف والمجال تصبح صفراً.'},
{q:'قانون فاراداي للحث الكهرومغناطيسي ينص على أن القوة الدافعة المستحثة تتناسب طرديًا مع…',o:['المعدل الزمني للتغير في الفيض المغناطيسي','شدة التيار الأصلي فقط','المقاومة الكلية للدائرة','درجة حرارة السلك'],a:0,why:'قانون فاراداي: emf = -N (ΔΦ/Δt)، تتناسب طردياً مع المعدل الزمني لقطع خطوط الفيض.'},
{q:'قاعدة لنز تحدد اتجاه…',o:['التيار المستحث بحيث يعاكس التغير المسبب له','المجال المغناطيسي الأصلي','القوة الكهربية الساكنة','التيار المستمر في البطارية'],a:0,why:'قاعدة لنز: يكون اتجاه التيار الكهربي المستحث بحيث يعاكس التغير في الفيض المسبب له.'},
{q:'معامل الحث المتبادل بين ملفين يقاس بوحدة الهنري، والتي تكافئ…',o:['فولت · ثانية / أمبير','أمبير · ثانية / فولت','أوم / ثانية','فولت / ثانية'],a:0,why:'الهنري يكافئ (فولت · ثانية / أمبير) أو (أوم · ثانية) أو (ويبر / أمبير).'},
{q:'للحد من التيارات الدوامية في المحول الكهربي يُصنع القلب الحديدي من…',o:['حديد مطاوع سيليكوني على شكل شرائح معزولة','كتلة صلبة من النحاس','حديد زهر مصمت','كتلة من الألومنيوم'],a:0,why:'تقسيم القلب إلى شرائح معزولة من الحديد السيليكوني ذي المقاومة النوعية الكبيرة يقلل فقد الطاقة بالتيارات الدوامية.'},
{q:'في الدينامو البسيط، يتحول التيار المتردد إلى تيار موحد الاتجاه في الدائرة الخارجية باستبدال حلقتي الانزلاق بـ…',o:['أسطوانة معدنية مشقوقة لنصفين معزولين','مقاومة متغيرة','مكثف ثابت السعة','ملف حث إضافي'],a:0,why:'الأسطوانة المعدنية المشقوقة (المقوم المعدني) تعكس توصيل طرفي الملف كل نصف دورة لتوحيد اتجاه التيار في الدائرة الخارجية.'},
{q:'القيمة الفعالة لشدة التيار المتردد (I_eff) تساوي…',o:['0.707 من القيمة العظمى','نصف القيمة العظمى','ضعف القيمة العظمى','تساوي القيمة العظمى دائمًا'],a:0,why:'I_eff = I_max / √2 ≈ 0.707 × I_max.'},
{q:'المحول الرافع للجهد يكون فيه…',o:['عدد لفات الملف الثانوي أكبر من الابتدائي','عدد لفات الابتدائي أكبر من الثانوي','شدة تيار الثانوي أكبر من الابتدائي','التردد في الثانوي أكبر من الابتدائي'],a:0,why:'في المحول الرافع للجهد يكون Ns > Np و Vs > Vp بينما تيار الثانوي أقل من تيار الابتدائي.'},
{q:'المفاعلة الحثية لملف حث (XL) تتناسب طرديًا مع…',o:['تردد التيار ومعامل الحث الذاتي','سعة المكثف','المقاومة الأومية فقط','زاوية الطور فقط'],a:0,why:'XL = 2πfL، وبالتالي تتناسب طردياً مع التردد f ومعامل الحث الذاتي L.'},
{q:'في دائرة تيار متردد تحتوي على ملف حث نقي فقط، فإن فرق الجهد…',o:['يتقدم في الطور على التيار بربع دورة (90°)','يتأخر عن التيار بربع دورة (90°)','يتفق في الطور مع التيار','يتأخر بمقدار 180°'],a:0,why:'في ملف الحث النقي، يسبق الجهد الكلي التيار بزاوية طور مقدارها 90 درجة بسبب emf المستحثة العكسية.'},
{q:'المفاعلة السعوية لمكثف (XC) تتناسب عكسيًا مع…',o:['تردد التيار وسعة المكثف','معامل الحث الذاتي','المقاومة الأومية','القوة الدافعة العظمى'],a:0,why:'XC = 1 / (2πfC)، تتناسب عكسياً مع كلاً من التردد f وسعة المكثف C.'},
{q:'في دائرة تيار متردد تحتوي على مكثف نقي فقط، فإن التيار الكهربي…',o:['يتقدم في الطور على فرق الجهد بربع دورة (90°)','يتأخر عن الجهد بربع دورة','يتفق مع الجهد في الطور','ينعدم تمامًا'],a:0,why:'في المكثف النقي، يتقدم التيار على فرق الجهد بزاوية طور 90 درجة.'},
{q:'في دائرة رنين (RLC)، تكون المعاوقة الكلية للدائرة في أقل قيمة وتساوي…',o:['المقاومة الأومية R','المفاعلة الحثية XL','المفاعلة السعوية XC','صفرًا'],a:0,why:'في حالة الرنين تكون XL = XC، فتلاشي كل منهما الأخرى وتصبح المعاوقة Z = R وتكون الدائرة في حالة خواص أومية.'},
{q:'وفقًا لفروض بلانك، تصدر الإشعاعات الكهرومغناطيسية من الذرات المهتزة على شكل…',o:['كمات محددة من الطاقة تسمى فوتونات','موجات متصلة لا نهائية','جسيمات موجبة الشحنة','إلكترونات حرة'],a:0,why:'افترض ماكس بلانك أن الإشعاع يتكون من كمات أو دفقات من الطاقة تسمى كوانتم أو فوتونات طاقة كل منها E = h.ν.'},
{q:'دالة الشغل لسطح فلز تتوقف فقط على…',o:['نوع مادة سطح الفلز','شدة الضوء الساقط','تردد الضوء الساقط','زمن سقوط الضوء'],a:0,why:'دالة الشغل هي أقل طاقة تكفي لتحرير إلكترون دون إكسابه طاقة حركة وتعتمد على نوع مادة الفلز فقط.'},
{q:'في ظاهرة كومتون، بعد اصطدام فوتون أشعة جاما بإلكترون حر، فإن الطول الموجي للفوتون المشتت…',o:['يزداد','يقل','يظل ثابتًا','ينعدم'],a:0,why:'يفقد الفوتون جزءاً من طاقته للإلكترون فتقل طاقته ويقل تردده وبالتالي يزداد طوله الموجي.'},
{q:'الطول الموجي المصاحب لجسيم متحرك (موجة دي براولي) يتعين من العلاقة…',o:['λ = h / (m · v)','λ = m · v / h','λ = h · c / E','λ = E / (m · c)'],a:0,why:'علاقة دي براولي: الطول الموجي للموجة المادية المصاحبة للجسيم هو λ = h / P = h / (m.v).'},
{q:'تعتمد فكرة عمل الميكروسكوب الإلكتروني على…',o:['الطبيعة الموجية للإلكترونات السريعة','ظاهرة التأثير الكهروضوئي','انكسار الضوء في العدسات الزجاجية','حيود الأشعة السينية فقط'],a:0,why:'يعتمد الميكروسكوب الإلكتروني على الطبيعة الموجية للإلكترون، حيث تصاحب حركته موجات ذات طول موجي قصير جداً يمكن التحكم به.'},
{q:'طاقة فوتون الضوء تتناسب طرديًا مع…',o:['تردده','طوله الموجي','سرعته في الفراغ','سعة موجته'],a:0,why:'E = h × ν، تتناسب طاقة الفوتون طردياً مع تردده ν.'},
{q:'سلسلة بالمر في طيف ذرة الهيدروجين تقع في منطقة…',o:['الضوء المنظور','الأشعة فوق البنفسجية','الأشعة تحت الحمراء البعيدة','أشعة جاما'],a:0,why:'سلسلة بالمر تنتج من عودة الإلكترون إلى المستوى الثاني n=2 وتقع فوتوناتها في نطاق الضوء المرئي.'},
{q:'ينتج الطيف الخطي المميز للأشعة السينية نتيجة…',o:['انتقال إلكترون من مستوى طاقة خارجي ليحل محل إلكترون انتزع من مستوى داخلي','تباطؤ الإلكترونات المصطدمة بالهدف','تشتت كومبتون للإلكترونات','تفريغ كهربي في أنبوبة كولدج'],a:0,why:'الأشعة السينية المميزة تنتج عند هبوط إلكترون من مستوى علوي ليشغل فراغاً تركه إلكترون داخلي من ذرات مادة الهدف.'},
{q:'الفوتونات الناتجة بالانبعاث المستحث في الليزر تتميز بأنها…',o:['مترابطة ولها نفس الطور والتردد والاتجاه','مشتتة ومختلفة التردد','تتحرك بسرعات متغيرة','غير متفقة في الاتجاه'],a:0,why:'الانبعاث المستحث ينتج فوتونات مطابقة تماماً للفوتون الساقط في الطور والتردد والاتجاه (مترابطة).'},
{q:'الشرط الأساسي لتوليد شعاع الليزر هو الوصول بالوسط الفعال إلى حالة…',o:['الإسكان المعكوس','الاتزان الحراري الكامل','التأين الكامل للذرات','الصفر المطلق'],a:0,why:'الإسكان المعكوس يعني وجود عدد من الذرات في مستويات الإثارة شبه المستقرة أكبر من عددها في المستوى الأدنى.'},
{q:'تزداد التوصيلية الكهربية لشبه موصل نقي من السيليكون عند…',o:['رفع درجة حرارته','خفض درجة حرارته إلى الصفر المطلق','توصيله بمصدر مستمر فقط','تقليل تركيز الشوائب'],a:0,why:'برفع درجة الحرارة تنكسر بعض الروابط التساهمية وتتحرر إلكترونات وتنشأ فجوات تزيد من التوصيلية.'},
{q:'في بلورة شبه الموصل من النوع الموجب (p-type)، تكون الشوائب المضافة من عناصر…',o:['ثلاثية التكافؤ مثل البورون أو الألومنيوم','خماسية التكافؤ مثل الفسفور','أحادية التكافؤ','رباعية التكافؤ'],a:0,why:'تطعيم السيليكون بعنصر ثلاثي التكافؤ مثل البورون ينتج فجوات موجبة إضافية فتصبح البلورة من النوع p.'},
{q:'تعتبر الوصلة الثنائية (الدايود) في حالة توصيل أمامي عندما يُوصل القطب الموجب للبطارية بـ…',o:['المنطقة الموجبة P والقطب السالب بالمنطقة السالبة N','المنطقة السالبة N والقطب السالب بالمنطقة الموجبة P','الأرضي مباشرة','مقاومة مجزئ الجهد'],a:0,why:'في التوصيل الأمامي يوصل القطب الموجب بالمنطقة P والسالب بـ N مما يقلل حاجز الجهد ويسمح بمرور التيار.'},
{q:'بوابة المعامل المنطقي (NOT) يطلق عليها اسم…',o:['العاكس (Inverter)','الجامع','المضاعف','المحول'],a:0,why:'بوابة NOT تعكس إشارة الدخل: فالصفر يخرج واحداً، والواحد يخرج صفراً.'},
{q:'بوابة (AND) المنطقية تعطي خرجًا يساوي 1 فقط إذا كان…',o:['جميع المداخل تساوي 1','أحد المداخل تساوي 1','جميع المداخل تساوي 0','المدخل الأول عكس الثاني'],a:0,why:'بوابة AND تشترط تحقق جميع المدخلات معاً (1 على كل مدخل) لتعطي خرجاً مساوياً 1.'}
];
const questionBanks=[physicsQuestions,[
{q:'ما الجسيم الموجود في نواة الذرة ويحمل شحنة موجبة؟',o:['الإلكترون','البروتون','النيوترون','الفوتون'],a:1,why:'البروتون موجب الشحنة ويوجد في النواة. الإلكترون سالب الشحنة، والنيوترون متعادل.'},
{q:'ذرة متعادلة عددها الذري ٨. كم إلكترونًا تحتوي؟',o:['٨ إلكترونات','٤ إلكترونات','١٦ إلكترونًا','٦ إلكترونات'],a:0,why:'العدد الذري يساوي عدد البروتونات. في الذرة المتعادلة يتساوى عدد الإلكترونات والبروتونات.'},
{q:'نظيران للعنصر نفسه يختلفان في عدد…',o:['البروتونات','الإلكترونات في الذرة المتعادلة','النيوترونات','الشحنات الموجبة'],a:2,why:'نظائر العنصر لها نفس العدد الذري، وتختلف في عدد النيوترونات ومن ثم العدد الكتلي.'}
],[
{q:'إذا كانت د(س) = س²، فما د′(س)؟',o:['س','٢س','٢','س³'],a:1,why:'مشتقة س أس ن هي ن × س أس (ن−١). لذلك مشتقة س² هي ٢س.'},
{q:'ما مشتقة الدالة الثابتة د(س) = ٧؟',o:['صفر','٧','١','٧س'],a:0,why:'قيمة الدالة الثابتة لا تتغير مع س، لذلك معدل تغيرها ومشتقتها يساويان صفرًا.'},
{q:'إذا كانت د(س) = ٣س²، فما قيمة د′(٢)؟',o:['٣','٦','١٢','٢٤'],a:2,why:'د′(س) = ٦س، وبالتعويض بس = ٢ نحصل على ١٢.'}
]];
const catalogTitles=[['قانون أوم والدوائر الكهربية','تدريب على التيار والمقاومة','مراجعة أساسيات الكهرباء'],['تركيب الذرة','تدريب على العدد الذري','مراجعة الذرة والنظائر'],['أساسيات الاشتقاق','تدريب على مشتقة الدالة','مراجعة التفاضل']];
const catalog=catalogTitles.flatMap((titles,owner)=>titles.map((title,index)=>({id:owner*3+index,owner,title,unit:['افهم الأساس','اختبر نفسك','راجع مستواك'][index],questions:questionBanks[owner].slice(index).concat(questionBanks[owner].slice(0,index))})));
const MANAGER_KEY='emtehanatak-manager-demo-v1';
let managedDrafts=[],publishedExams=[],editingDraft=null;
function escapeHtml(value){return String(value).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function validExam(e){return e&&typeof e.title==='string'&&e.title.trim().length>0&&e.title.length<=120&&Number.isInteger(e.owner)&&people[e.owner]&&Array.isArray(e.questions)&&e.questions.length===3&&e.questions.every(q=>typeof q.q==='string'&&q.q.trim()&&q.q.length<=1000&&typeof q.why==='string'&&q.why.trim()&&q.why.length<=1500&&Array.isArray(q.o)&&q.o.length===4&&q.o.every(o=>typeof o==='string'&&o.trim()&&o.length<=300)&&Number.isInteger(q.a)&&q.a>=0&&q.a<4)}
function saveManager(){try{localStorage.setItem(MANAGER_KEY,JSON.stringify({drafts:managedDrafts,published:publishedExams}));return true}catch{notify('تعذّر الحفظ على الجهاز. المسودة لسه موجودة في الصفحة.');return false}}
function loadManager(){try{const value=JSON.parse(localStorage.getItem(MANAGER_KEY)||'null');if(!value)return;managedDrafts=(Array.isArray(value.drafts)?value.drafts:[]).filter(validExam).slice(0,50);publishedExams=(Array.isArray(value.published)?value.published:[]).filter(validExam).slice(0,100);publishedExams.forEach(e=>catalog.push({...e,id:catalog.length,unit:'امتحان جديد'}))}catch{managedDrafts=[];publishedExams=[]}}
function blankExam(){return {title:'',owner:0,questions:Array.from({length:3},()=>({q:'',o:['','','',''],a:0,why:''}))}}
function readExamForm(form){const values=new FormData(form);return {title:String(values.get('title')||'').trim(),owner:Number(values.get('owner')),questions:Array.from({length:3},(_,i)=>({q:String(values.get('question-'+i)||'').trim(),o:Array.from({length:4},(_,j)=>String(values.get('option-'+i+'-'+j)||'').trim()),a:Number(values.get('answer-'+i)),why:String(values.get('explanation-'+i)||'').trim()}))}}
function saveExamForm(form,publish){const value=readExamForm(form);if(!validExam(value)){notify('كمّل العنوان والأسئلة والاختيارات وشرح الحل.');return}if(publish&&publishedExams.length>=100){notify('وصلت لحد المعاينة: ١٠٠ امتحان.');return}if(!publish&&editingDraft===null&&managedDrafts.length>=50){notify('وصلت لحد المعاينة: ٥٠ مسودة.');return}if(publish){publishedExams.push(value);catalog.push({...value,id:catalog.length,unit:'امتحان جديد'});if(editingDraft!==null)managedDrafts.splice(editingDraft,1)}else if(editingDraft===null)managedDrafts.unshift(value);else managedDrafts[editingDraft]=value;editingDraft=null;const saved=saveManager();go('admin');if(saved)notify(publish?'اتنشر الامتحان داخل المعاينة، وتقدر تحلّه كطالب.':'اتحفظت المسودة على الجهاز.')}
let activeExam=0,questions=catalog[0].questions;
const followed=new Set();
function selectExam(id){const next=catalog.find(x=>x.id===id);if(!next)return;clearInterval(timerId);activeExam=id;questions=next.questions;answers=new Array(questions.length).fill(null);flagged=new Set();qIndex=0;started=false;remaining=(id===0?2535:300);go('details')}
let theme='orbit',page='home',teacher=0,filter='الكل',query='',qIndex=13,answers=Array.from({length:45},(_,i)=>i<13?(i%4):null),flagged=new Set([6,13]),drawerOpen=false,started=true,remaining=2535,timerId=null,toastId;answers[13]=1;
const STORAGE_KEY='emtehanatak-student-demo-v1';
let attemptHistory=[],draft=null,currentResult=null,storageAvailable=true;
function validAnswers(value){return Array.isArray(value)&&value.length>0&&value.every(x=>x===null||(Number.isInteger(x)&&x>=0&&x<4))}
function validRecord(value){return value&&Number.isInteger(value.examId)&&catalog[value.examId]&&validAnswers(value.answers)&&Number.isFinite(value.finishedAt)&&value.finishedAt>0}
function persist(){try{localStorage.setItem(STORAGE_KEY,JSON.stringify({attempts:attemptHistory,draft,followed:[...followed]}))}catch{if(storageAvailable){storageAvailable=false;notify('الحفظ على الجهاز مش متاح؛ بياناتك هتفضل لحد ما تقفل الصفحة.')}}}
function saveDraft(){if(!draft||!started)return;draft.answers=[...answers];draft.question=qIndex;persist()}
function loadStudent(){try{const data=JSON.parse(localStorage.getItem(STORAGE_KEY)||'null');if(!data)return;attemptHistory=Array.isArray(data.attempts)?data.attempts.filter(validRecord).slice(0,100):[];if(Array.isArray(data.followed))data.followed.filter(n=>Number.isInteger(n)&&people[n]).forEach(n=>followed.add(n));const d=data.draft;if(d&&Number.isInteger(d.examId)&&catalog[d.examId]&&validAnswers(d.answers)&&Number.isFinite(d.deadline)&&Number.isInteger(d.question)&&d.question>=0&&d.question<d.answers.length){draft=d;resumeDraft()}else currentResult=attemptHistory[0]||null}catch{attemptHistory=[];draft=null}}
function restoreDraft(){activeExam=draft.examId;questions=catalog[activeExam].questions;answers=[...draft.answers];qIndex=draft.question;started=true;remaining=Math.max(0,Math.ceil((draft.deadline-Date.now())/1000))}
function resumeDraft(){if(!draft)return;restoreDraft();if(!remaining){finishAttempt();return}startTicker();go('exam')}
function startTicker(){clearInterval(timerId);timerId=setInterval(()=>{if(!draft)return;remaining=Math.max(0,Math.ceil((draft.deadline-Date.now())/1000));if($('timer'))$('timer').textContent=time();if(remaining===0){restoreDraft();finishAttempt();notify('انتهى الوقت واتحفظت نتيجتك.')}},1000)}
function finishAttempt(){if(!draft)return;clearInterval(timerId);currentResult={examId:draft.examId,answers:[...answers],finishedAt:Date.now(),elapsed:Math.min(300,Math.max(0,300-Math.ceil((draft.deadline-Date.now())/1000)))};attemptHistory.unshift(currentResult);attemptHistory=attemptHistory.slice(0,100);draft=null;persist();go('result')}
function resultScore(record){const qs=catalog[record.examId]?.questions||questions;return record.answers.reduce((n,a,i)=>n+(a===(qs[i]?.a??-1)?1:0),0)}
function emptyStudent(title,description){return `<section class="student-empty"><span class="empty-book">${icon('book')}</span><h1>${title}</h1><p>${description}</p>${btn('اختار امتحانك الأول','exams')}</section>`}
const $=id=>document.getElementById(id),btn=(label,to,kind='')=>`<button class="btn ${kind}" data-go="${to}">${label}</button>`,heading=(title,desc='')=>`<div class="page-title"><h1>${escapeHtml(title)}</h1>${desc?`<p>${escapeHtml(desc)}</p>`:''}</div>`;
const nav=()=>[['home','home','الرئيسية'],['teachers','users','المدرسين'],['exams','book','امتحاناتي'],['profile','user','حسابي']].map(([to,i,label])=>`<button class="navbtn ${page===to?'active':''}" data-go="${to}">${icon(i)}${label}</button>`).join('');
function notify(message){$('live').innerHTML='';const el=document.createElement('div');el.className='toast';el.textContent=message;$('live').append(el);clearTimeout(toastId);toastId=setTimeout(()=>$('live').innerHTML='',2800)}
function cards(){return people.map((p,i)=>({p,i})).filter(({p})=>(page!=='teachers'||((filter==='الكل'||filter===p.subject)&&(!query||p.name.includes(query)||p.subject.includes(query))))).map(({p,i})=>`<button class="teacher poster-teacher teacher-${i}" data-teacher="${i}" aria-label="عرض امتحانات أ. ${p.name}، ${p.subject}"><div class="portrait"><img src="${p.photo}" alt="صورة توضيحية لملف المدرس" width="700" height="850" loading="lazy"><div class="poster-top"><span class="subject">${p.subject}</span><span class="poster-grade">ثالثة ثانوي</span></div><div class="poster-title"><span class="teacher-prefix">${i===1?'الأستاذة':'الأستاذ'}</span><h3>${p.name}</h3><span class="poster-caption">امتحانات وتدريبات ${p.subject}</span></div></div><div class="teacher-footer"><span class="exam-summary"><span class="exam-count">${p.count}</span><span>امتحان متاح<span class="exam-summary-sub">اختار امتحانك وابدأ</span></span></span><span class="teacher-cta">شوف الامتحانات <span class="cta-arrow">${icon('arrow')}</span></span></div></button>`).join('')||'<p class="muted">مفيش مدرس مطابق للبحث. جرّب اسم أو مادة تانية.</p>'}
function exams(){const entries=page==='teacher'?catalog.filter(e=>e.owner===teacher):page==='home'?catalog.filter(e=>e.id%3===0):catalog;return `<div class="exam-grid">${entries.map(e=>{const p=people[e.owner];return `<article class="exam-card"><div class="exam-card-top"><span class="tag">${p.subject}</span><span class="exam-level">${e.unit}</span></div><h3>${escapeHtml(e.title)}</h3><div class="exam-owner"><img src="${p.photo}" alt="" width="32" height="32"><span>أ. ${p.name}</span></div><div class="exam-meta"><span>${icon('book')} ٣ أسئلة</span><span>${icon('clock')} ٥ دقائق</span></div><button class="exam-open" data-exam="${e.id}">${page==='admin'?'راجع الامتحان':'تفاصيل الامتحان'} ${icon('arrow')}</button></article>`}).join('')}</div>`}
function home(){return `${heading('أهلًا يا يوسف 👋','مستعد لخطوة جديدة؟')}<section class="hero"><div><small>الثالث الثانوي · مساحة امتحاناتك</small><h1>${themes[theme].headline}</h1><p>${themes[theme].sub}</p>${btn('اكتشف الامتحانات '+icon('arrow'),'exams')}</div><div class="hero-art" aria-hidden="true"><img src="assets/logo-white.svg" alt=""></div></section><div class="section-title"><h2>مدرسين تتابعهم</h2><button class="linkbtn" data-go="teachers">شوف الكل ←</button></div><div class="teachers">${cards()}</div><div class="section-title"><h2>جرّب مستواك النهارده</h2><span class="tag">جديد</span></div>${exams()}`}
function teacherPage(){const p=people[teacher];return `<button class="linkbtn" data-go="teachers">الرجوع لكل المدرسين ←</button><section class="teacher-hero"><div class="teacher-intro"><span class="teacher-subject-label">${p.subject} · الثالث الثانوي</span><p class="teacher-honorific">${teacher===1?'الأستاذة':'الأستاذ'}</p><h1>${p.name}</h1><p class="teacher-intro-copy">اختار امتحانك، اختبر فهمك، وراجع كل إجابة بخطوات واضحة.</p><button class="btn follow-button" data-action="follow" aria-pressed="${followed.has(teacher)}">${followed.has(teacher)?'بتتابعه ✓':'تابع المدرس +'}</button></div><div class="teacher-hero-image"><img src="${p.photo}" alt="صورة توضيحية لملف المدرس" width="700" height="850"></div></section><div class="teacher-promises"><span>${icon('book')} تدريب على المنهج</span><span>${icon('clock')} اختبارات قصيرة</span><span>${icon('check')} تصحيح مع شرح</span></div><div class="section-title"><div><h2>امتحانات ${p.name.split(' ')[0]}</h2><p class="muted">ابدأ بالأساسيات، وبعدها اختبر نفسك.</p></div><span class="tag">${catalog.filter(e=>e.owner===teacher).length} امتحانات للتجربة</span></div>${exams()}` }
function details(){const e=catalog[activeExam],p=people[e.owner];return `<button class="linkbtn" data-go="exams">الرجوع للامتحانات ←</button><section class="exam-detail-head"><span class="tag">${p.subject} · ${e.unit}</span><h1>${escapeHtml(e.title)}</h1><div class="exam-owner"><img src="${p.photo}" alt="" width="40" height="40"><span>أ. ${p.name}</span></div></section><div class="columns"><section class="exam-start-panel"><h2>خُد وقتك، وورّينا مستواك.</h2><p class="muted">٣ أسئلة اختيار من متعدد، مع التصحيح وشرح الإجابات بعد التسليم.</p><div class="exam-facts"><div>${icon('book')}<strong>٣</strong><span>أسئلة</span></div><div>${icon('clock')}<strong>٥</strong><span>دقائق</span></div><div>${icon('check')}<strong>٣</strong><span>درجات</span></div></div><button class="btn full" data-action="start">ابدأ الامتحان ${icon('arrow')}</button></section><section class="exam-guidance"><h3>قبل ما تبدأ</h3><ol><li>اختار إجابة واحدة لكل سؤال.</li><li>تقدر ترجع وتغيّر إجاباتك قبل التسليم.</li><li>النتيجة والشرح بيظهروا بعد التسليم.</li></ol><p class="muted">دي تجربة توضيحية. المحاولة محفوظة على جهازك، والوقت مستمر حتى لو قفلت الصفحة.</p></section></div>`}
function exam(){
  if(!draft) {
    draft={examId:activeExam,answers:[...answers],question:qIndex,deadline:Date.now()+remaining*1000};
  }
  let q=questions[qIndex] || questions[0];
  let answeredCount=answers.filter(x=>x!==null).length;
  let totalCount=questions.length;
  let pct=Math.round((answeredCount/totalCount)*100);
  let isFlagged=flagged.has(qIndex);

  let bubblesHtml=questions.map((_,i)=>{
    let isAns=answers[i]!==null;
    let isFlg=flagged.has(i);
    let isCur=i===qIndex;
    let cls=isCur?'current':isFlg?'flagged':isAns?'answered':'';
    return `<button data-question="${i}" class="exam-q-bubble ${cls}" aria-label="السؤال ${i+1}">${i+1}</button>`;
  }).join('');

  let sideMapHtml=`<aside class="exam-map-panel">
    <div class="exam-map-head">
      <h3>خريطة الأسئلة (${totalCount} سؤال)</h3>
    </div>
    <div class="exam-legend-row">
      <span><i class="dot ans"></i> تمت الإجابة (${answeredCount})</span>
      <span><i class="dot flg"></i> للمراجعة (${flagged.size})</span>
      <span><i class="dot un"></i> متبقي (${totalCount-answeredCount})</span>
    </div>
    <div class="exam-bubbles-grid">${bubblesHtml}</div>
    <button class="btn full" style="margin-top:20px;background:#0A1D3D;" data-action="submit">تسليم وإنهاء الامتحان</button>
  </aside>`;

  let drawerHtml=`<div class="exam-mobile-sheet-overlay ${drawerOpen?'open':''}" id="examDrawer">
    <div class="exam-mobile-sheet" role="dialog" aria-modal="true" aria-label="خريطة الأسئلة">
      <div style="display:flex;justify-content:space-between;align-items:center;">
        <h3 style="margin:0;font-size:18px;font-weight:800;color:#0A1D3D;">خريطة الأسئلة (${totalCount} سؤال)</h3>
        <button class="exam-sheet-close" data-action="close-map" aria-label="إغلاق">✕</button>
      </div>
      <div class="exam-legend-row">
        <span><i class="dot ans"></i> تمت الإجابة (${answeredCount})</span>
        <span><i class="dot flg"></i> للمراجعة (${flagged.size})</span>
        <span><i class="dot un"></i> متبقي (${totalCount-answeredCount})</span>
      </div>
      <div class="exam-bubbles-grid" style="max-height:50vh;overflow-y:auto;padding:4px;">
        ${bubblesHtml}
      </div>
      <button class="btn full" style="background:#0A1D3D;margin-top:10px;" data-action="submit">تسليم وإنهاء الامتحان</button>
    </div>
  </div>`;

  let diagramHtml='';
  if(q.diagram==='circuit'){
    diagramHtml=`<div class="exam-diagram-box">${circuitSvg}</div>`;
  }

  let optionsHtml=q.o.map((o,i)=>{
    let isSelected=answers[qIndex]===i;
    return `<button class="exam-option-btn ${isSelected?'selected':''}" data-answer="${i}" aria-pressed="${isSelected}">
      <div style="display:flex;align-items:center;gap:12px;">
        <span style="font-weight:700;color:${isSelected?'#0E8F8F':'#475569'};">${['(أ)','(ب)','(ج)','(د)'][i]}</span>
        <span style="font-size:15px;color:${isSelected?'#0F766E':'#1E293B'};">${escapeHtml(o)}</span>
      </div>
      <span class="check-circle" style="${isSelected?'':'opacity:0;'}">${isSelected?icon('check'):''}</span>
    </button>`;
  }).join('');

  return `<div class="exam-view-wrapper" style="display:flex;flex-direction:column;min-height:100%;flex:1;width:100%;box-sizing:border-box;">
    <header class="exam-header">
      <span class="exam-timer-chip">
        <span id="timer">${time()}</span>
      </span>
      <button class="exam-counter-chip" data-action="toggle-map" title="عرض خريطة الأسئلة">
        <span>${qIndex+1} من ${totalCount}</span>
      </button>
      <div class="exam-brand-area">
        <img class="exam-brand-logo" src="assets/logo-white.svg" alt="امتحاناتك">
      </div>
    </header>

    <div class="exam-progress-wrap">
      <div class="exam-progress-bar-bg">
        <div class="exam-progress-bar-fill" style="width:${pct}%;"></div>
      </div>
      <span class="exam-progress-pct">${pct}%</span>
    </div>

    <div class="exam-screen-body">
      <main class="exam-card-surface">
        <h2 class="exam-question-title">${qIndex+1}. ${escapeHtml(q.q)}</h2>
        ${diagramHtml}
        <div class="exam-options-stack">
          ${optionsHtml}
        </div>
      </main>
      ${sideMapHtml}
    </div>

    <footer class="exam-sticky-bar">
      <button class="exam-action-btn prev" data-action="prev" ${qIndex===0?'disabled':''}>
        <span>السابق</span>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
      <button class="exam-action-btn flag ${isFlagged?'active':''}" data-action="flag">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="${isFlagged?'currentColor':'none'}" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
        <span>علم للمراجعة</span>
      </button>
      ${qIndex<totalCount-1
        ?`<button class="exam-action-btn next" data-action="next"><span>التالي</span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg></button>`
        :`<button class="exam-action-btn next" data-action="submit"><span>سلّم الامتحان</span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></button>`
      }
    </footer>

    ${drawerHtml}
  </div>`;
}

function score(){return answers.reduce((n,a,i)=>n+(a===questions[i].a?1:0),0)}
function result(){const r=currentResult;if(!r)return emptyStudent('لسه مفيش نتيجة','حلّ أول امتحان، وهتلاقي نتيجتك وشرح كل إجابة هنا.');const n=resultScore(r),missed=r.answers.filter(x=>x===null).length;return `<div class="result result-new"><span class="tag">تم حفظ محاولتك على الجهاز</span><h1>${n===catalog[r.examId].questions.length?'عاش! قفلت الامتحان.':n>=catalog[r.examId].questions.length*0.7?'خطوة حلوة لقدّام.':'كل محاولة بتكشفلك خطوة.'}</h1><p class="muted">${escapeHtml(catalog[r.examId].title)}</p><div class="score"><svg class="score-ring" viewBox="0 0 190 190" aria-hidden="true"><circle cx="95" cy="95" r="90" fill="none" stroke="#DDEBFF" stroke-width="9"/><circle cx="95" cy="95" r="90" fill="none" stroke="#0759C7" stroke-width="9" stroke-dasharray="${(n/catalog[r.examId].questions.length)*565.487} 565.487" transform="rotate(-90 95 95)"/></svg><strong>${Math.round(n/catalog[r.examId].questions.length*100)}%</strong><small>${n} من ${catalog[r.examId].questions.length} درجات</small></div><div class="result-breakdown"><div><strong>${n}</strong><span>إجابة صحيحة</span></div><div><strong>${catalog[r.examId].questions.length-n-missed}</strong><span>إجابة خاطئة</span></div><div><strong>${missed}</strong><span>بدون إجابة</span></div></div><div class="next-step"><h3>${n===catalog[r.examId].questions.length?'ثبّت المعلومة بالمراجعة':'راجع الغلط، وافهم السبب'}</h3><p>كل سؤال معاه الإجابة الصحيحة وشرح بسيط للحل.</p></div>${btn('راجع إجاباتي '+icon('arrow'),'review')}<div class="result-actions">${btn('سجل امتحاناتي','profile','secondary')}${btn('امتحان جديد','exams','secondary')}</div></div>`}
function review(){const r=currentResult;if(!r)return emptyStudent('مراجعتك تبدأ بعد أول امتحان','بعد التسليم هتلاقي الأسئلة وإجاباتك وشرح الحل هنا.');return `${heading('نفهم الحل سوا',catalog[r.examId].title)}<div class="review-list">${catalog[r.examId].questions.map((q,i)=>{const a=r.answers[i],correct=a===q.a;return `<section class="review-card"><div class="review-header"><span>السؤال ${i+1} من ${catalog[r.examId].questions.length}</span><span class="answer-status ${correct?'correct':'incorrect'}">${correct?'✓ إجابة صحيحة':a===null?'لم تتم الإجابة':'إجابة غير صحيحة'}</span></div><h3>${escapeHtml(q.q)}</h3><div class="your-answer"><span>إجابتك</span><strong>${a===null?'بدون إجابة':escapeHtml(q.o[a])}</strong></div>${!correct?`<div class="review-answer">${icon('check')} الإجابة الصحيحة: ${escapeHtml(q.o[q.a])}</div>`:''}<div class="explanation"><h4>ليه دي الإجابة؟</h4><p>${escapeHtml(q.why)}</p></div></section>`}).join('')}</div><div class="row">${btn('ارجع للنتيجة','result','secondary')}${btn('اختار امتحان جديد','exams')}</div>`}
function profile(){const total=attemptHistory.length,avg=total?Math.round(attemptHistory.reduce((n,r)=>n+resultScore(r)/3*100,0)/total):null;return `${heading('خطواتك كلها هنا','كل امتحان بتحلّه بيضيف لصورتك عن مستواك.')}<section class="student-profile"><div class="student-avatar">ي</div><div><h2>يوسف أحمد</h2><p>الثالث الثانوي · حساب المعاينة</p></div><span class="tag">طالب</span></section><div class="student-metrics"><div><strong>${total}</strong><span>امتحان مكتمل</span></div><div><strong>${avg===null?'—':avg+'%'}</strong><span>متوسط نتائجك</span></div><div><strong>${followed.size}</strong><span>مدرس بتتابعه</span></div></div>${draft?`<section class="resume-card"><div><span class="tag">محاولة بدأت</span><h3>${escapeHtml(catalog[draft.examId].title)}</h3><p>إجاباتك محفوظة، والوقت بيكمل من بداية المحاولة.</p></div><button class="btn" data-action="resume">كمّل الامتحان ${icon('arrow')}</button></section>`:''}<div class="section-title"><h2>سجل امتحاناتك</h2><span class="muted">${total} محاولة</span></div>${total?`<div class="attempt-list">${attemptHistory.map((r,i)=>`<button class="attempt-row" data-history="${i}"><span class="attempt-percent">${Math.round(resultScore(r)/3*100)}<small>%</small></span><span class="attempt-info"><strong>${escapeHtml(catalog[r.examId].title)}</strong><small>${people[catalog[r.examId].owner].name} · ${new Date(r.finishedAt).toLocaleDateString('ar-EG')}</small></span><span class="attempt-view">النتيجة ${icon('arrow')}</span></button>`).join('')}</div>`:emptyStudent('أول خطوة لسه جاية','ابدأ بامتحان قصير، وسجلك هيتكوّن مع كل محاولة.')}<p class="local-note">السجل محفوظ في المتصفح ده فقط. دي معاينة غير مرتبطة بحساب حقيقي.</p>`}
function login(){return `<div class="form">${heading('حلو إنك هنا.','ادخل حسابك وكمّل من آخر خطوة.')}<div class="brand" style="margin-bottom:30px"><img class="wordmark login-logo" src="assets/logo.svg" alt="امتحاناتك"></div><form id="loginForm"><label class="field">رقم الموبايل<input type="tel" inputmode="tel" pattern="01[0125][0-9]{8}" placeholder="01xxxxxxxxx" required dir="ltr" autocomplete="tel"></label><label class="field">كلمة المرور<input type="password" minlength="6" required placeholder="٦ أحرف على الأقل" autocomplete="current-password"></label><button class="btn full" type="submit">ادخل حسابك</button></form><p class="muted" style="margin-top:20px">نموذج عرض فقط. استخدم بيانات وهمية؛ مفيش بيانات بتتبعت.</p><button class="linkbtn" data-go="home">تصفّح الامتحانات الأول ←</button></div>`}
function admin(){return `${heading('إدارة امتحاناتك','المحتوى والمحاولات في مكان واحد.')}<div class="admin-welcome"><div><h2>جهّز امتحان يفرق مع الطالب.</h2><p>اكتب الأسئلة، أضف شرح الحل، وراجع المحتوى قبل النشر.</p></div><button class="btn" data-action="new-exam">+ إضافة امتحان</button></div><div class="student-metrics"><div><strong>${catalog.length}</strong><span>امتحان في المعاينة</span></div><div><strong>${managedDrafts.length}</strong><span>مسودة محفوظة</span></div><div><strong>${attemptHistory.length}</strong><span>محاولة على الجهاز</span></div></div><div class="section-title"><h2>المسودات</h2><span class="tag">تقدر تكمّلها بعدين</span></div>${managedDrafts.length?`<div class="admin-list">${managedDrafts.map((e,i)=>`<div class="admin-exam-row"><span class="admin-status">مسودة</span><div><h3>${escapeHtml(e.title)}</h3><small>أ. ${people[e.owner].name} · ٣ أسئلة</small></div><button class="btn secondary" data-edit-draft="${i}">كمّل التعديل ${icon('arrow')}</button></div>`).join('')}</div>`:'<div class="admin-empty">مفيش مسودات لسه. تقدر تحفظ أي امتحان وتكمله بعدين.</div>'}<div class="section-title"><h2>الامتحانات المنشورة</h2><span class="muted">${catalog.length} امتحان</span></div><div class="admin-list">${[...catalog].reverse().map(e=>`<div class="admin-exam-row"><span class="admin-subject">${people[e.owner].subject}</span><div><h3>${escapeHtml(e.title)}</h3><small>أ. ${people[e.owner].name} · ٣ أسئلة · ٥ دقائق</small></div><button class="btn secondary" data-exam="${e.id}">معاينة ${icon('arrow')}</button></div>`).join('')}</div><p class="local-note">النشر هنا داخل المتصفح فقط. مفيش حسابات حقيقية أو نشر على الإنترنت.</p>`}
function editor(){const data=editingDraft===null?blankExam():managedDrafts[editingDraft]||blankExam();return `<button class="linkbtn" data-go="admin">الرجوع للإدارة ←</button>${heading(editingDraft===null?'امتحان جديد':'كمّل مسودتك','نموذج قصير من ٣ أسئلة، مدته ٥ دقائق.')}<form id="editorForm"><section class="editor-basics"><label class="field">اسم الامتحان<input name="title" required maxlength="120" placeholder="مثال: مراجعة الفصل الأول" value="${escapeHtml(data.title)}"></label><label class="field">المدرس<select name="owner">${people.map((p,i)=>`<option value="${i}" ${data.owner===i?'selected':''}>${p.name} · ${p.subject}</option>`).join('')}</select></label></section><div class="editor-question-list">${data.questions.map((q,i)=>`<fieldset class="editor-question"><legend>السؤال ${i+1}</legend><label class="field">نص السؤال<textarea name="question-${i}" required maxlength="1000" placeholder="اكتب السؤال بوضوح">${escapeHtml(q.q)}</textarea></label><div class="editor-options">${q.o.map((o,j)=>`<label class="field"><span>الاختيار ${['أ','ب','ج','د'][j]}</span><input name="option-${i}-${j}" required maxlength="300" value="${escapeHtml(o)}"></label>`).join('')}</div><label class="field">الإجابة الصحيحة<select name="answer-${i}">${['أ','ب','ج','د'].map((c,j)=>`<option value="${j}" ${q.a===j?'selected':''}>الاختيار ${c}</option>`).join('')}</select></label><label class="field">شرح الحل<textarea name="explanation-${i}" required maxlength="1500" placeholder="اشرح للطالب ليه الإجابة دي صحيحة">${escapeHtml(q.why)}</textarea></label></fieldset>`).join('')}</div><div class="editor-publish"><div><h3>جاهز للتجربة؟</h3><p>المسودة للإدارة فقط، والنشر يضيف الامتحان لقائمة الطالب في المعاينة.</p></div><div class="row"><button class="btn secondary" type="submit" name="intent" value="draft">احفظ مسودة</button><button class="btn" type="submit" name="intent" value="publish">انشر في المعاينة ${icon('arrow')}</button></div></div></form>`}

function render(){const t=themes[theme];$('app').dataset.theme=theme;$('pageSelect').value=page;$('app').classList.toggle('in-exam-screen', page==='exam');$('sidebar').innerHTML=`<div class="brand"><img class="wordmark" src="assets/logo.svg" alt="امتحاناتك"></div><small class="muted">مساحتك للامتحانات</small><nav>${nav()}</nav><button class="navbtn ${page==='admin'?'active':''}" data-go="admin">${icon('settings')}لوحة الإدارة</button><div class="sidebar-foot"><strong>خطوة على قدّك، كل يوم.</strong>تصوّر مستقل للعرض والتجربة</div>`;$('appbar').innerHTML=`<div class="desktop-crumb"><strong>${pages[page]}</strong><small> / الثالث الثانوي</small></div><div class="brand mobile-brand"><img class="wordmark" src="assets/logo.svg" alt="امتحاناتك"></div><div class="row"><button class="iconbtn" data-action="notifications" aria-label="الإشعارات">${icon('bell')}</button><button class="avatar" data-go="profile" aria-label="حساب يوسف">ي</button></div>`;$('bottomnav').innerHTML=nav();$('themeNote').textContent='امتحاناتك · الهوية المعتمدة: الكلمة كتاب. معاينة تفاعلية ببيانات توضيحية، بدون اتصال بالسيرفر أو قاعدة البيانات.';const content={home,teachers:()=>`${heading('مدرسك المفضّل هنا','اختار المادة، وابدأ مع المدرس اللي يناسبك.')}<label class="search">${icon('search')}<input id="teacherSearch" aria-label="ابحث عن مدرس أو مادة" placeholder="ابحث عن مدرس أو مادة"></label><div class="chips">${['الكل','فيزياء','كيمياء','رياضيات'].map(f=>`<button class="chip ${filter===f?'selected':''}" data-filter="${f}">${f}</button>`).join('')}</div><div class="teachers" id="teacherResults">${cards()}</div>`,teacher:teacherPage,exams:()=>`${heading('امتحانك الجاي هنا','تدرّب في الفيزياء والكيمياء والرياضيات، وراجع نتيجتك مع الشرح.')}<div class="catalog-note">${icon('book')} ${catalog.length} امتحان في المعاينة · ٣ مدرسين · تصحيح فوري</div>${exams()}`,details,exam,result,review,profile,login,admin,editor};$('content').innerHTML=content[page]();$('content').classList.remove('enter');void $('content').offsetWidth;$('content').classList.add('enter');if($('teacherSearch'))$('teacherSearch').value=query}
function go(p){if(p==='exam'&&draft){restoreDraft();startTicker()}page=p;render()}
function time(){return Math.floor(remaining/60).toString().padStart(2,'0')+':'+(remaining%60).toString().padStart(2,'0')}
function start(){if(draft){if(draft.examId!==activeExam){notify('عندك محاولة بدأت بالفعل. كمّلها الأول من حسابك.');return}resumeDraft();return}const totalTime=activeExam===0?2535:300;answers=new Array(questions.length).fill(null);flagged=new Set();remaining=totalTime;qIndex=0;started=true;draft={examId:activeExam,answers:[...answers],question:0,deadline:Date.now()+totalTime*1000};persist();startTicker();go('exam')}

$('pageSelect').innerHTML=Object.entries(pages).map(([p,n])=>`<option value="${p}">${n}</option>`).join('');$('pageSelect').addEventListener('change',e=>go(e.target.value));$('device').addEventListener('change',e=>$('app').classList.toggle('mobile',e.target.value==='mobile'));
document.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.theme){theme=b.dataset.theme;render()}else if(b.dataset.go)go(b.dataset.go);else if(b.dataset.editDraft!==undefined){editingDraft=Number(b.dataset.editDraft);go('editor')}else if(b.dataset.history!==undefined){currentResult=attemptHistory[Number(b.dataset.history)]||null;go('result')}else if(b.dataset.exam!==undefined){selectExam(Number(b.dataset.exam))}else if(b.dataset.teacher!==undefined){teacher=Number(b.dataset.teacher);go('teacher')}else if(b.dataset.filter){filter=b.dataset.filter;render()}else if(b.dataset.answer!==undefined){if(draft){answers[qIndex]=Number(b.dataset.answer);saveDraft();render()}}else if(b.dataset.question!==undefined){qIndex=Number(b.dataset.question);drawerOpen=false;saveDraft();render()}else if(b.dataset.action){switch(b.dataset.action){case'new-exam':editingDraft=null;go('editor');break;case'start':start();break;case'resume':resumeDraft();break;case'flag':if(flagged.has(qIndex))flagged.delete(qIndex);else flagged.add(qIndex);render();break;
case'toggle-map':drawerOpen=!drawerOpen;render();break;
case'close-map':drawerOpen=false;render();break;
case'next':qIndex=Math.min(questions.length-1,qIndex+1);saveDraft();render();break;case'prev':qIndex=Math.max(0,qIndex-1);saveDraft();render();break;case'submit':if(answers.includes(null)){notify('كمّل الأسئلة المتبقية قبل التسليم.');qIndex=answers.indexOf(null);render()}else{finishAttempt()}break;case'follow':if(followed.has(teacher))followed.delete(teacher);else followed.add(teacher);persist();render();notify(followed.has(teacher)?'بتتابع المدرس دلوقتي.':'اتلغت المتابعة.');break;case'notifications':notify('مفيش إشعارات جديدة. جاهز لامتحانك؟');break;}}});
document.addEventListener('input',e=>{if(e.target.id==='teacherSearch'){query=e.target.value;$('teacherResults').innerHTML=cards()}});document.addEventListener('submit',e=>{e.preventDefault();if(e.target.id==='loginForm'){notify('تم الدخول التجريبي. أهلًا يا يوسف!');go('home')}else if(e.target.id==='editorForm'){saveExamForm(e.target,e.submitter?.value==='publish')}});
const urlParams = new URLSearchParams(window.location.search);
if (urlParams.has('page')) page = urlParams.get('page');
if (urlParams.has('device')) {
  $('device').value = urlParams.get('device');
  $('app').classList.toggle('mobile', urlParams.get('device') === 'mobile');
}
if (urlParams.get('drawer') === 'open') {
  drawerOpen = true;
}
loadManager();render();loadStudent();
if (urlParams.has('page')) page = urlParams.get('page');
render();

</script>
</body></html>

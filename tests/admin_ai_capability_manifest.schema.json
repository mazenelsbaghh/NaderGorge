{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Admin AI capability baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAtUtc", "activation", "sources", "items", "digest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "activation": { "enum": ["blocked", "reviewed", "active", "superseded"] },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "frontend", "semantic"],
      "properties": {
        "runtime": { "$ref": "#/$defs/source" },
        "frontend": { "$ref": "#/$defs/source" },
        "semantic": { "$ref": "#/$defs/source" }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    },
    "exclusions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exclusion" }
    },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "method", "route", "effect", "domain", "risk", "confirmation", "status", "authoritativeOperation", "inputSchema", "outputSchema", "limits", "idempotency", "concurrency", "audit", "refreshScopes", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
        "kind": { "enum": ["backend-endpoint", "frontend-call"] },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "ANY"] },
        "route": { "type": "string", "minLength": 1 },
        "effect": { "enum": ["read", "preview", "export", "mutation", "external-side-effect", "blocked"] },
        "domain": { "enum": ["identity", "content", "assessment", "commercial", "finance", "hr", "operations", "support", "reporting", "system", "other"] },
        "risk": { "enum": ["none", "ordinary", "strong"] },
        "confirmation": { "enum": ["none", "ordinary", "strong"] },
        "status": { "enum": ["candidate", "blocked", "adapted", "excluded"] },
        "authoritativeOperation": { "type": "string", "minLength": 1 },
        "inputSchema": { "type": "string", "minLength": 1 },
        "outputSchema": { "type": "string", "minLength": 1 },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxRows", "maxBytes", "timeoutMs"],
          "properties": {
            "maxRows": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "maxBytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 },
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 }
          }
        },
        "idempotency": { "enum": ["none", "required", "existing", "missing"] },
        "concurrency": { "enum": ["none", "version", "fingerprint", "missing"] },
        "audit": { "enum": ["read-evidence", "required", "existing", "missing"] },
        "refreshScopes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "line"],
          "properties": {
            "file": { "type": "string", "minLength": 1 },
            "line": { "type": "integer", "minimum": 1 }
          }
        },
        "blocker": { "type": "string" }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason", "detail"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "reason": { "enum": ["public-surface", "student-surface", "teacher-surface", "self-service", "e2e-only", "deployment-only", "non-business"] },
        "detail": { "type": "string", "minLength": 1 }
      }
    }
  }
}

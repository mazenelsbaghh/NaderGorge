[Unit]
Description=Create and archive a safe Massar PostgreSQL PITR probe
After=network-online.target patroni.service massar-backup-bucket.service
Requires=massar-backup-bucket.service

[Service]
Type=oneshot
EnvironmentFile=/etc/massar/backup/pgbackrest.env
ExecStart=/usr/local/sbin/massar-prepare-pitr-probe
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Unit]
Description=Safely remove obsolete Massar Docker images
After=network-online.target docker.service glusterd.service
RequiresMountsFor=/srv/massar-shared

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/massar-image-cleanup --yes
TimeoutStartSec=30min
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run /srv/massar-shared/.image-cleanup.lock -/var/log/pgbackrest -/var/log/glusterfs
ReadOnlyPaths=/opt/massar /var/lib/massar /etc/massar
StandardOutput=journal
StandardError=journal

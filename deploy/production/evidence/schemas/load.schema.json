{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "runId",
    "releaseId",
    "capturedAt",
    "startedAt",
    "completedAt",
    "requestedRps",
    "achievedRps",
    "durationSeconds",
    "requestedDuration",
    "baselineRps",
    "baselineMultiplier",
    "profile",
    "excludedNode",
    "capacityStages",
    "websocketVus",
    "websocketHoldSuccessRate",
    "workflowRps",
    "workflowProbes",
    "workflowSuccessRate",
    "expectedNodes",
    "observedNodes",
    "nodeRequestCounts",
    "nodeTrafficShares",
    "nodeImbalanceRatio",
    "unexpectedNodeRate",
    "healthyNodeCount",
    "errorRate",
    "checkRate",
    "p95Milliseconds",
    "p99Milliseconds",
    "surfaceP95Milliseconds",
    "surfaceP99Milliseconds",
    "droppedIterations",
    "droppedIterationRate",
    "thresholdFailures"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["success", "failed"] },
    "runId": { "type": "string", "minLength": 1 },
    "releaseId": {
      "type": "string",
      "pattern": "^(?:git-[0-9a-f]{7,40}|src-[0-9a-f]{40})$"
    },
    "capturedAt": { "type": "string", "format": "date-time" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "requestedRps": { "type": "number", "exclusiveMinimum": 0 },
    "achievedRps": { "type": "number", "minimum": 0 },
    "durationSeconds": { "type": "integer", "minimum": 0 },
    "requestedDuration": { "type": "string", "minLength": 1 },
    "baselineRps": { "type": "number", "exclusiveMinimum": 0 },
    "baselineMultiplier": { "type": "number", "minimum": 0 },
    "profile": {
      "enum": ["steady", "n-minus-one", "rolling-deploy", "failover"]
    },
    "excludedNode": {
      "type": ["string", "null"],
      "enum": ["node-1", "node-2", "node-3", null]
    },
    "capacityStages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["duration", "target"],
        "properties": {
          "duration": { "type": "string", "minLength": 1 },
          "target": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "websocketVus": { "type": "number", "minimum": 0 },
    "websocketHoldSuccessRate": { "type": "number", "minimum": 0, "maximum": 1 },
    "workflowRps": { "type": "number", "minimum": 0 },
    "workflowProbes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["public-asset-read", "protected-asset-read", "invalid-upload-validation"]
      }
    },
    "workflowSuccessRate": { "type": "number", "minimum": 0, "maximum": 1 },
    "expectedNodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["node-1", "node-2", "node-3"] }
    },
    "observedNodes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["node-1", "node-2", "node-3"] }
    },
    "healthyNodeCount": { "type": "integer", "minimum": 0, "maximum": 3 },
    "nodeRequestCounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node-1": { "type": "number", "minimum": 0 },
        "node-2": { "type": "number", "minimum": 0 },
        "node-3": { "type": "number", "minimum": 0 }
      }
    },
    "nodeTrafficShares": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node-1": { "type": "number", "minimum": 0, "maximum": 1 },
        "node-2": { "type": "number", "minimum": 0, "maximum": 1 },
        "node-3": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "nodeImbalanceRatio": { "type": "number", "minimum": 0 },
    "unexpectedNodeRate": { "type": "number", "minimum": 0, "maximum": 1 },
    "errorRate": { "type": "number", "minimum": 0, "maximum": 1 },
    "checkRate": { "type": "number", "minimum": 0, "maximum": 1 },
    "p95Milliseconds": { "type": "number", "minimum": 0 },
    "p99Milliseconds": { "type": "number", "minimum": 0 },
    "surfaceP95Milliseconds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["landing", "apiLive"],
      "properties": {
        "landing": { "type": "number", "minimum": 0 },
        "apiLive": { "type": "number", "minimum": 0 }
      }
    },
    "surfaceP99Milliseconds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["landing", "apiLive"],
      "properties": {
        "landing": { "type": "number", "minimum": 0 },
        "apiLive": { "type": "number", "minimum": 0 }
      }
    },
    "droppedIterations": { "type": "number", "minimum": 0 },
    "droppedIterationRate": { "type": "number", "minimum": 0, "maximum": 1 },
    "thresholdFailures": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

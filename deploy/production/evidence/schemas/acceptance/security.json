{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "releaseId", "capturedAt", "scope", "directOriginDenied", "internalPortsClosed", "wrongHostDenied", "sourceEvidenceSha256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "status": {"enum": ["success", "failed"]},
    "releaseId": {"type": "string", "pattern": "^(?:git-[0-9a-f]{7,40}|src-[0-9a-f]{40})$"},
    "capturedAt": {"type": "string", "format": "date-time"},
    "scope": {"const": "pre-dns"},
    "directOriginDenied": {"type": "boolean"},
    "internalPortsClosed": {"type": "boolean"},
    "wrongHostDenied": {"type": "boolean"},
    "sourceEvidenceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

# Root-owned 0600 file installed as /etc/massar/backup/files.env.
RESTIC_REPOSITORY=s3:http://127.0.0.1:9000/massar-backups/massar/files
AWS_ACCESS_KEY_ID=<read-from:/etc/massar/secrets/backup-s3-access>
AWS_SECRET_ACCESS_KEY=<read-from:/etc/massar/secrets/backup-s3-secret>
AWS_DEFAULT_REGION=massar-internal
RESTIC_PASSWORD_FILE=/etc/massar/secrets/restic-password

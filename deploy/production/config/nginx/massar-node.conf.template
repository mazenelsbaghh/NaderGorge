server {
    listen 8080;
    server_name api.massar-academy.net;
    location / {
        proxy_pass http://backend:5245;
    }
}

server {
    listen 8080;
    server_name ws.massar-academy.net;
    location / {
        access_log /var/log/nginx/access.log massar_websocket_safe;
        # Client disconnects are expected for long-lived sockets. Logging them
        # at error level both creates noise and includes the original URI.
        error_log /var/log/nginx/error.log crit;
        proxy_pass http://backend:5245;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }
}

server {
    listen 8080;
    server_name assets.massar-academy.net;
    root /var/www/assets;
    add_header X-Massar-Node "${MASSAR_NODE_ID}" always;
    add_header X-Massar-Release "${MASSAR_RELEASE_ID}" always;

    location ^~ /protected/ { return 404; }
    location ^~ /private/ { return 404; }
    location ^~ /.tmp/ { return 404; }
    location / {
        try_files $uri =404;
        add_header Access-Control-Allow-Origin "$massar_cors_origin" always;
        add_header Vary Origin always;
        add_header Cache-Control "public, max-age=86400, must-revalidate, no-transform" always;
    }
}

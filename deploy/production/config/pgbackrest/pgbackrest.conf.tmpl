[massar]
pg1-path=/var/lib/postgresql/16/massar
pg1-port=5432

[global]
repo1-type=s3
repo1-path=/massar/postgresql
repo1-s3-endpoint=127.0.0.1
repo1-s3-bucket=massar-backups
repo1-s3-region=massar-internal
repo1-s3-uri-style=path
repo1-storage-port=9443
repo1-storage-ca-file=/etc/massar/pki/backup-ca.crt
repo1-storage-verify-tls=y
repo1-s3-key=__S3_ACCESS_KEY__
repo1-s3-key-secret=__S3_SECRET_KEY__
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=__PGBACKREST_CIPHER_PASS__
repo1-retention-full-type=time
repo1-retention-full=30
repo1-retention-archive-type=full
repo1-bundle=y
repo1-block=y
archive-async=y
spool-path=/var/spool/pgbackrest
start-fast=y
process-max=2
compress-type=zst
compress-level=3
archive-timeout=300
log-level-console=info

[global:archive-push]
process-max=2

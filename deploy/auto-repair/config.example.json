  "agent_network": "massar-repair-internal",
  "codex_home": "/home/massar-ops/.local/share/massar-auto-repair/codex-home",
  "https_proxy": "http://massar-repair-proxy:3128",
  "postgres_image": "REPLACE_WITH_INSTALLED_POSTGRES16_DIGEST",
  "redis_image": "REPLACE_WITH_INSTALLED_REDIS7_DIGEST"
}

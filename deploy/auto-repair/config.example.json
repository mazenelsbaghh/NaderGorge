{
  "api_url": "https://api.massar-academy.net",
  "token_file": "/etc/massar/auto-repair.token",
  "state_dir": "/var/lib/massar/auto-repair",
  "source_repository": "/var/lib/massar/auto-repair-source",
  "source_ref": "REPLACE_WITH_VERIFIED_FULL_GIT_COMMIT",
